---
import { dateLabel } from '../lib/company-directory.mjs';
import { employeeAnalysisLabels, employeeAnalysisBoundary } from '../lib/company-employee-analysis.mjs';
const { company, report, inDialog = false } = Astro.props;
const Title = inDialog ? 'h2' : 'h1';
const sources = report?.sources || company.sources.map((source, index) => ({ ...source, id: `listing-${index}`, kind: '收录资料', note: '仅支持目录信息，尚无员工视角分析。' }));
const numberFor = id => sources.findIndex(source => source.id === id) + 1;
const sourceTarget = id => `employee-source-${company.id}-${id}`;
const languageFor = source => /[가-힣]/.test(source.originalTitle || '') ? 'ko' : /[\u3400-\u9fff]/.test(source.originalTitle || '') ? 'zh-CN' : source.url.endsWith('/es') ? 'es' : 'en';
---
<div class="co-employee-analysis" data-employee-analysis={company.id}>
  <header class="cea-heading"><div><Title id={!inDialog ? '_top' : undefined} data-analysis-title>{company.name}</Title><p>{company.aliases?.find(alias => /公司|集团/.test(alias)) || `${company.category} · ${company.location}`}</p></div><a href={company.website} target="_blank" rel="noopener noreferrer">访问官网 ↗</a></header>
  <p class="cea-business">{report?.publicSummary || company.summary} <a class="cea-ref" href={`#${sourceTarget(sources[0].id)}`} data-analysis-citation aria-label="查看产品依据来源">[1]</a></p>
  {report ? <>
    <section class="cea-verdict" data-level={report.level}>
      <div class="cea-meta"><span class="cea-status">{employeeAnalysisLabels[report.level]}</span><span>公司层面 · 岗位未指定</span></div>
      <h3>{report.action}</h3>
      <p>判断（推断）：{report.thesis} {report.basisSources.map(id => <a class="cea-ref" href={`#${sourceTarget(id)}`} data-analysis-citation aria-label={`查看判断依据来源 ${numberFor(id)}`}>[{numberFor(id)}]</a>)}</p>
    </section>
    {report.facts?.length > 0 && <><dl class="cea-facts">{report.facts.map(fact => <div><dt>{fact.label}</dt><dd>{fact.value}</dd><small>{fact.note}</small></div>)}</dl><p class="cea-fact-scope">{report.factScope} {Array.from(new Set(report.facts.flatMap(fact => fact.sources))).map(id => <a class="cea-ref" href={`#${sourceTarget(id)}`} data-analysis-citation aria-label={`查看数据来源 ${numberFor(id)}`}>[{numberFor(id)}]</a>)}</p></>}
    <section class="cea-career"><h3>职业积累<span>产品 → 推断</span></h3><p>{report.careerSources.map(id => <a class="cea-ref" href={`#${sourceTarget(id)}`} data-analysis-citation aria-label={`查看职业分析依据来源 ${numberFor(id)}`}>[{numberFor(id)}]</a>)} {report.career}</p></section>
    <section class="cea-counter"><h3>主要风险与最强反驳 {report.counterSources.map(id => <a class="cea-ref" href={`#${sourceTarget(id)}`} data-analysis-citation aria-label={`查看风险分析依据来源 ${numberFor(id)}`}>[{numberFor(id)}]</a>)}</h3><p>{report.counter}</p></section>
    <dl class="cea-change"><dt>何时改判</dt><dd>{report.change}</dd></dl>
    <details class="cea-questions"><summary>进一步核实的两个问题</summary><ol>{report.questions.map(question => <li>{question}</li>)}</ol></details>
  </> : <section class="cea-verdict" data-level="limited"><h3>新收录公司，员工分析待补充。</h3><p>已有目录与产品来源，尚不形成就业判断。</p></section>}
  <details class="cea-sources" data-analysis-sources><summary>信息来源与证据口径 · {sources.length} 项</summary>
    <ol>{sources.map((source, index) => <li id={sourceTarget(source.id)} data-analysis-source><a href={source.url} target="_blank" rel="noopener noreferrer">[{index + 1}] {source.title} ↗</a>{source.originalTitle && <p>原题：<span lang={languageFor(source)}>{source.originalTitle}</span></p>}<p>{source.kind} · 查阅 / 整理 {dateLabel(source.asOf)}</p><p>{source.note}</p></li>)}</ol>
    {report && <p class="cea-confidence">公司级判断置信度：{report.confidence}</p>}
  </details>
  <footer class="cea-footer"><p>{report ? `分析基准 ${dateLabel(report.reviewedAt)}。` : ''}{employeeAnalysisBoundary}</p><div>{inDialog ? <><a href={`/companies/${company.id}/`}>独立页面 ↗</a><button type="button" data-company-close>返回公司列表</button></> : <a href="/companies/">← 返回公司列表</a>}</div></footer>
</div>
