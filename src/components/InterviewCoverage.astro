---
import { getCollection } from 'astro:content';
import { interviewModules } from '../lib/interview-taxonomy.mjs';
const questions = await getCollection('docs', entry => Boolean(entry.data.interview));
---
<table>
  <thead><tr><th>能力模块</th><th>已收录的二级专题</th><th>待补齐</th></tr></thead>
  <tbody>{interviewModules.map(module => {
    const entries = questions.filter(entry => entry.data.interview!.module === module.id);
    const populated = module.topics.filter(topic => entries.some(entry => entry.data.interview!.topic === topic.id));
    const missing = module.topics.filter(topic => !populated.includes(topic));
    return <tr>
      <td><a href={`/interview/?module=${module.id}`}>{module.label}</a><br />{entries.length} 题</td>
      <td>{populated.length ? populated.map((topic, index) => <>{index > 0 && '、'}<a href={`/interview/?module=${module.id}&topic=${topic.id}`}>{topic.label}（{entries.filter(entry => entry.data.interview!.topic === topic.id).length}）</a></>) : '暂无独立题目'}</td>
      <td>{missing.length ? missing.map(topic => topic.label).join('、') : '当前专题均有题目'}</td>
    </tr>;
  })}</tbody>
</table>
