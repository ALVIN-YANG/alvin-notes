---
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import SystemDesignSearch from './SystemDesignSearch.astro';

const { sidebar } = Astro.locals.starlightRoute;

function extractDate(href: string): string {
  const match = href.match(/(\d{4}-\d{2}-\d{2})/);
  return match ? match[1] : '0000-00-00';
}

function sortByDateDesc(a: any, b: any): number {
  return extractDate(b.href).localeCompare(extractDate(a.href));
}

function splitAiNews(group: any): any {
  const links = group.entries.filter((e: any) => e.type === 'link');
  const weekly = links
    .filter((e: any) => e.href.includes('-weekly'))
    .sort(sortByDateDesc);
  const other = links
    .filter((e: any) => !e.href.includes('-weekly'));

  const entries: any[] = [];
  if (other.length) entries.push(...other);
  if (weekly.length) {
    entries.push({
      type: 'group',
      label: '周报',
      entries: weekly,
      collapsed: false,
      badge: undefined,
    });
  }
  return { ...group, entries };
}

function containsCurrentPage(entry: any): boolean {
  if (entry.type === 'link') return entry.isCurrent;
  return entry.entries.some(containsCurrentPage);
}

const currentGroup = sidebar.find(
  (entry) => entry.type === 'group' && containsCurrentPage(entry),
);

const filteredSidebar = currentGroup
  ? [currentGroup.label === 'AI News' ? splitAiNews(currentGroup) : currentGroup]
  : [];
---

{Astro.url.pathname.startsWith('/system-design/') && <SystemDesignSearch />}
{Astro.url.pathname.startsWith('/phoenix/') && <SystemDesignSearch indexUrl="/phoenix-search.json" label="搜索凤凰架构" />}

<SidebarPersister>
  <SidebarSublist sublist={filteredSidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>
