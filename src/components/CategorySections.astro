const allDocs = await getCollection('docs');

function parseDateFromFilename(id: string): Date | null {
  if (typeof id !== 'string') return null;
  const match = id.match(/(\d{4}-\d{2}-\d{2})/);
  if (match) return new Date(match[1]);
  return null;
}

function getFilenameOrder(id: string): number {
  if (typeof id !== 'string') return 0;
  const numMatch = id.match(/\/(\d{1,2})-/);
  return numMatch ? parseInt(numMatch[1], 10) : 0;
}

function getDocDate(doc: typeof allDocs[number]): number {
  if (doc.data.lastUpdated) return new Date(doc.data.lastUpdated).getTime();
  if (doc.data.date) return new Date(doc.data.date).getTime();
  const parsed = parseDateFromFilename(doc.id);
  if (parsed) return parsed.getTime();
  return 0;
}

function isArticle(doc: typeof allDocs[number]) {
  const id = doc.id;
  return Boolean(id && !id.endsWith('index') && !id.includes('_category_') && id !== 'index.mdx');
}

function getCategoryDocs(categoryIds: string[], count = 5) {
  return allDocs
    .filter((doc) => {
      if (!isArticle(doc)) return false;
      return categoryIds.some((categoryId) => doc.id.startsWith(`${categoryId}/`));
    })
    .sort((a, b) => {
      const dateDiff = getDocDate(b) - getDocDate(a);
      if (dateDiff !== 0) return dateDiff;
      return getFilenameOrder(b) - getFilenameOrder(a);
    })
    .slice(0, count);
}

const sections = categories.map((cat) => {
  const categoryIds = 'prefixes' in cat ? cat.prefixes : [cat.id];
  const matchesCategory = (doc: typeof allDocs[number]) => (
    isArticle(doc) && categoryIds.some((categoryId) => doc.id.startsWith(`${categoryId}/`))
  );

  return {
    ...cat,
    docs: getCategoryDocs(categoryIds),
    count: allDocs.filter(matchesCategory).length,
  };
});

const compactDateFormatter = new Intl.DateTimeFormat('zh-CN', {
  month: '2-digit',
  day: '2-digit',
});

function formatDate(doc: typeof allDocs[number]) {
  const value = doc.data.lastUpdated || doc.data.date;
  if (!value) return '';
  return compactDateFormatter.format(new Date(value)).replace('/', '.');
}
---

<section class="home-library not-content" aria-labelledby="home-library-title">
  <div class="home-library-intro">
    <h2 id="home-library-title"><a href="/career/">职业手册</a></h2>
    <nav class="home-library-types" aria-label="手册分类">
      <a href="/career/?type=handbooks">知识手册 <span>{handbookCount}</span></a>
      <a href="/career/?type=resources">精选资源 <span>{resourceCount}</span></a>
    </nav>
    <a class="home-library-all" href="/career/">浏览全部 {careerLibrary.length} 本 <span aria-hidden="true">→</span></a>
  </div>
  <nav class="home-library-books" aria-label="精选手册">
    {featuredBooks.map(book => <a class="home-library-book" href={book.href} aria-label={`阅读${book.title}`}><CareerBookCover book={book} eager /></a>)}
  </nav>
</section>
<nav class="home-library-shortcuts not-content" aria-label="快捷查阅">
  <a href="/ai-concepts/">AI 概念</a>
  <a href="/companies/">公司观察</a>
  <a href="/interview/">AI 工程问答</a>
  <a href="/projects/game-guides/">游戏攻略</a>
</nav>

<div class="home-sections" aria-label="文章分栏">
  {
    sections.map((cat) => (
      <section class="section-card" aria-labelledby={`section-${cat.id}`}>
        <span class="section-accent" aria-hidden="true"></span>

        <a href={cat.href} class="section-header">
          <span class="section-title-row">
            <span class="section-title" id={`section-${cat.id}`}>{cat.title}</span>
          </span>
          <span class="section-desc">{cat.desc}</span>
          <span class="section-count">{cat.count} 篇文章</span>
        </a>

        {cat.docs.length > 0 && (
          <ul class="section-list">
            {cat.docs.map((doc) => {
              const href = `/${doc.id.replace(/\.mdx?$/, '').replace(/\/index$/, '/')}/`;
              return (
                <li class="section-item">
                  <a href={href} class="section-link">
                    <span class="section-link-title">{doc.data.title}</span>
                    <time datetime={new Date(doc.data.lastUpdated || doc.data.date || 0).toISOString()}>{formatDate(doc)}</time>
                  </a>
                </li>
              );
            })}
          </ul>
        )}
      </section>
    ))
  }
</div>

<style>
  .home-sections {
    display: grid;
    gap: 0.72rem;
    margin: 0 0 2.5rem;
  }

  .section-card {
    display: grid;
    grid-template-columns: 0.25rem minmax(11rem, 0.7fr) minmax(0, 1.8fr);
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2.5rem);
    margin: 0;
    padding: 1.15rem 1.35rem;
    background: color-mix(in srgb, var(--sl-color-surface) 66%, var(--sl-color-bg));
    border-radius: 0.85rem;
    box-shadow: 0 1px 2px rgba(36, 41, 47, 0.022), 0 10px 28px rgba(36, 41, 47, 0.028);
    animation: sectionFadeIn 0.4s ease-out both;
    transition: background-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .section-card:hover {
    background: color-mix(in srgb, var(--sl-color-surface) 82%, var(--sl-color-bg));
    box-shadow: 0 2px 4px rgba(36, 41, 47, 0.025), 0 14px 32px rgba(36, 41, 47, 0.04);
    transform: translateY(-1px);
  }

  .section-accent {
    align-self: start;
    width: 0.25rem;
    height: 1.35rem;
    margin-top: 0.15rem;
    border-radius: 999px;
    background: #3f78e6;
  }

  .section-header {
    display: block;
    min-width: 0;
    text-decoration: none !important;
    color: inherit;
  }

  .section-title-row {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
  }

  .section-header:hover .section-title {
    color: #2458c6;
  }

  .section-title {
    display: block;
    font-family: var(--sl-font-heading);
    font-size: clamp(1.18rem, 1.65vw, 1.42rem);
    font-weight: 600;
    color: var(--sl-color-white);
    margin: 0;
    line-height: 1.2;
    letter-spacing: 0;
    transition: color 0.2s ease;
  }

  .section-desc {
    display: block;
    max-width: 19rem;
    margin-top: 0.35rem;
    color: var(--sl-color-gray-2);
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .section-count {
    display: block;
    margin-top: 0.5rem;
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-utility);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.03em;
  }

  .section-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(1.25rem, 3vw, 3.25rem);
  }

  .section-list > .section-item {
    margin: 0;
    padding: 0;
  }

  .section-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.7rem;
    margin: 0 -0.35rem;
    padding: 0.31rem 0.35rem;
    text-decoration: none !important;
    color: var(--sl-color-gray-1);
    border-radius: 0.35rem;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .section-link:hover {
    color: #2458c6;
    background: color-mix(in srgb, #dfe9fb 42%, transparent);
  }

  .section-link:hover time {
    color: #2458c6;
  }

  .section-link-title {
    min-width: 0;
    font-family: var(--sl-font);
    font-size: 0.85rem;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: 0;
    font-synthesis: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .section-link time {
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-utility);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
  }

  .section-link:focus-visible,
  .section-header:focus-visible {
    border-radius: 3px;
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 3px;
  }

  @keyframes sectionFadeIn {
    from {
      opacity: 0;
      transform: translateY(0.35rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-card { animation: none; }
  }

  @media (max-width: 800px) {
    .section-card {
      grid-template-columns: 0.25rem minmax(8.5rem, 0.72fr) minmax(0, 1.4fr);
      gap: 0.9rem;
      padding: 1rem;
    }

    .section-list {
      grid-template-columns: 1fr;
    }

    .section-item:nth-child(n + 4) {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .section-card {
      grid-template-columns: 0.25rem minmax(0, 1fr);
      gap: 0.8rem;
      padding: 1rem;
    }

    .section-header {
      padding-right: 0.25rem;
    }

    .section-list {
      grid-column: 2;
      margin-top: 0.15rem;
    }

    .section-count {
      margin-top: 0.5rem;
    }
  }
</style>
