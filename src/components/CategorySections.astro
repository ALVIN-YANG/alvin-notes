---
import { getCollection } from 'astro:content';
import agentKnowledge from '../data/agent-knowledge.json';
import algorithmLearningMap from '../data/algorithm-learning-map';
import { algorithmTemplates, algorithmTop30Problems } from '../data/algorithm-curriculum';
import systemDesignKnowledge from '../data/system-design-knowledge';

const abilityMaps = [
  {
    id: 'algorithm',
    title: '算法能力地图',
    desc: '先学解题模板，再闭卷解决高频题。',
    href: '/algorithm-knowledge/',
    route: ['识别信号', '守住不变量', '闭卷解题'],
    stats: `${algorithmTemplates.length} 种模板 · ${algorithmTop30Problems.length} 道高频题`,
    pointCount: algorithmLearningMap.meta.pointCount,
  },
  {
    id: 'system',
    title: '系统设计能力地图',
    desc: '从需求与容量出发，一路推到故障恢复。',
    href: '/system-design-knowledge/',
    route: ['明确约束', '设计取舍', '故障恢复'],
    stats: `${systemDesignKnowledge.meta.domainCount} 个领域 · ${systemDesignKnowledge.meta.pointCount} 个知识点`,
    pointCount: systemDesignKnowledge.meta.pointCount,
  },
  {
    id: 'agent',
    title: 'AI Agent 能力地图',
    desc: '串起模型、工具、记忆、评测与生产运行。',
    href: '/agent-knowledge/',
    route: ['判断边界', '组织执行', '评测运行'],
    stats: `${agentKnowledge.meta.domainCount} 个领域 · ${agentKnowledge.meta.pointCount} 个知识点`,
    pointCount: agentKnowledge.meta.pointCount,
