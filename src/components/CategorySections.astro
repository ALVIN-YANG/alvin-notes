  },
  {
    id: 'ai-workflow',
    title: 'AI 工作流',
    desc: 'AI Coding、Skills 与开发工具链',
    href: '/ai-workflow/ai-coding-skills-selection-guide/',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>',
  },
  {
    id: 'architecture',
    title: 'Architecture',
    desc: '分布式系统、事件驱动与业务建模',
    href: '/architecture/distributed-transaction/',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>',
  },
  {
    id: 'claw',
    title: 'OpenClaw',
    desc: '插件开发、模型接入与生产部署',
    href: '/claw/openclaw/',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><path d="M9 15l2 2 4-4"/></svg>',
  },
  {
    id: 'ai-news',
    title: 'AI News',
    desc: '每周 AI 工程变化与趋势判断',
    href: '/ai-news/',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-4 0v-2a2 2 0 0 1 2-2h12"/><path d="M8 6h8"/><path d="M8 10h8"/><path d="M8 14h5"/></svg>',
  },
  {
    id: 'java',
    title: 'Java',
    desc: '并发、框架、中间件与架构实践',
    href: '/java/01-core/1-java21-virtual-threads/',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><line x1="10" y1="9" x2="16" y2="9"/><line x1="10" y1="13" x2="14" y2="13"/></svg>',
  },
  {
    id: 'algorithms',
    title: '算法',
    desc: '用模式组织高频题，减少机械背题',
    href: '/algorithms/java-high-frequency-algorithm-patterns/',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16M4 12h10M4 19h16"/><circle cx="17" cy="12" r="3"/></svg>',
  },
  {
    id: 'ops',
    title: 'Ops',
    desc: 'Kubernetes、排障与生产运行手册',
    href: '/ops/k8s/kubernetes-practical-starter-guide/',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/><circle cx="12" cy="12" r="3"/></svg>',
  },
  {
    id: 'network',
    title: '网络',
    desc: '网络协议与 AI Agent 通信',
    href: '/network/ai-agent-communication-protocols/',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="6" r="3"/><circle cx="19" cy="6" r="3"/><circle cx="12" cy="18" r="3"/><path d="M5 9v1a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9"/><path d="M12 15V9"/></svg>',
  },
  {
    id: 'security',
    title: '安全',
    desc: '漏洞机制、风险判断与处置',
    href: '/security/1-zero-day-vulnerability-primer/',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2l1.5 2h5L16 2"/><rect x="5" y="4" width="14" height="16" rx="7"/><path d="M2 9h3M19 9h3M2 15h3M19 15h3M9 9h6M9 13h6M12 13v5"/></svg>',
  },
];

const allDocs = await getCollection('docs');

function parseDateFromFilename(id: string): Date | null {
  if (typeof id !== 'string') return null;
  const match = id.match(/(\d{4}-\d{2}-\d{2})/);
  if (match) return new Date(match[1]);
  return null;
}

function getFilenameOrder(id: string): number {
  if (typeof id !== 'string') return 0;
  const numMatch = id.match(/\/(\d{1,2})-/);
  return numMatch ? parseInt(numMatch[1], 10) : 0;
}

function getDocDate(doc: typeof allDocs[number]): number {
  if (doc.data.lastUpdated) return new Date(doc.data.lastUpdated).getTime();
  if (doc.data.date) return new Date(doc.data.date).getTime();
  const parsed = parseDateFromFilename(doc.id);
  if (parsed) return parsed.getTime();
  return 0;
}

function isArticle(doc: typeof allDocs[number]) {
  const id = doc.id;
  return Boolean(id && !id.endsWith('index') && !id.includes('_category_') && id !== 'index.mdx');
}

function getCategoryDocs(categoryId: string, count = 5) {
  return allDocs
    .filter((doc) => {
      if (!isArticle(doc)) return false;
      return doc.id.startsWith(`${categoryId}/`);
    })
    .sort((a, b) => {
      const dateDiff = getDocDate(b) - getDocDate(a);
      if (dateDiff !== 0) return dateDiff;
      return getFilenameOrder(b) - getFilenameOrder(a);
    })
    .slice(0, count);
}

const sections = categories.map((cat) => ({
  ...cat,
  docs: getCategoryDocs(cat.id),
  count: allDocs.filter((doc) => isArticle(doc) && doc.id.startsWith(`${cat.id}/`)).length,
}));

const compactDateFormatter = new Intl.DateTimeFormat('zh-CN', {
  month: '2-digit',
  day: '2-digit',
});

function formatDate(doc: typeof allDocs[number]) {
  const value = doc.data.lastUpdated || doc.data.date;
  if (!value) return '';
  return compactDateFormatter.format(new Date(value)).replace('/', '.');
}
---

<section class="ability-map-showcase" aria-labelledby="ability-map-title">
  <header class="ability-map-heading">
    <div>
      <span class="ability-map-kicker">INTERVIEW MAPS</span>
      <h2 id="ability-map-title">三张能力地图</h2>
    </div>
    <p>看清全貌，找到薄弱点，再进入细节。</p>
  </header>

  <nav class="ability-map-grid" aria-label="面试能力地图">
    {
      abilityMaps.map((map) => (
        <a class={`ability-map-card ${map.id}`} href={map.href}>
          <span class="ability-map-card-head">
            <span class="ability-map-title">{map.title}</span>
            <svg class="ability-map-arrow" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12h13M13 6l6 6-6 6" />
            </svg>
          </span>
          <span class="ability-map-desc">{map.desc}</span>
          <span class="ability-map-route" aria-hidden="true">
            {map.route.map((stop) => <span>{stop}</span>)}
          </span>
          <span class="ability-map-stats">{map.stats}</span>
          <span class="sr-only">，共 {map.pointCount} 个知识点</span>
        </a>
      ))
    }
  </nav>
</section>

<div class="home-sections" aria-label="文章分栏">
  {
    sections.map((cat) => (
      <section class="section-card" aria-labelledby={`section-${cat.id}`}>
        <span class="section-accent" aria-hidden="true"></span>

        <a href={cat.href} class="section-header">
          <span class="section-title-row">
            <span class="section-title" id={`section-${cat.id}`}>{cat.title}</span>
          </span>
          <span class="section-desc">{cat.desc}</span>
          <span class="section-count">{cat.count} 篇文章</span>
        </a>

        {cat.docs.length > 0 && (
          <ul class="section-list">
            {cat.docs.map((doc) => {
              const href = `/${doc.id.replace(/\.mdx?$/, '').replace(/\/index$/, '/')}/`;
              return (
                <li class="section-item">
                  <a href={href} class="section-link">
                    <span class="section-link-title">{doc.data.title}</span>
                    <time datetime={new Date(doc.data.lastUpdated || doc.data.date || 0).toISOString()}>{formatDate(doc)}</time>
                  </a>
                </li>
              );
            })}
          </ul>
        )}
      </section>
    ))
  }
</div>

<style>
  .ability-map-showcase {
    margin: 1rem 0 1.4rem;
  }

  .ability-map-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 0.8rem;
  }

  .ability-map-kicker {
    display: block;
    margin-bottom: 0.18rem;
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-utility);
    font-size: 0.62rem;
    font-weight: 650;
    letter-spacing: 0.14em;
  }

  .ability-map-heading h2 {
    margin: 0;
    border: 0;
    color: var(--sl-color-white);
    font-family: var(--sl-font-heading);
    font-size: clamp(1.35rem, 2vw, 1.7rem);
    font-weight: 650;
    line-height: 1.2;
  }

  .ability-map-heading p {
    max-width: 22rem;
    margin: 0 0 0.1rem;
    color: var(--sl-color-gray-2);
    font-size: 0.78rem;
    line-height: 1.5;
    text-align: right;
  }

  .ability-map-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: 0.72rem;
  }

  .ability-map-card {
    --map-accent: #3f78e6;
    --map-wash: #e9f0ff;
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 13.25rem;
    overflow: hidden;
    flex-direction: column;
    padding: 1.15rem;
    border: 1px solid color-mix(in srgb, var(--map-accent) 18%, var(--sl-color-gray-5));
    border-radius: 0.9rem;
    background:
      radial-gradient(circle at 100% 0%, color-mix(in srgb, var(--map-wash) 48%, transparent) 0, transparent 46%),
      color-mix(in srgb, var(--sl-color-surface) 78%, var(--sl-color-bg));
    box-shadow: 0 1px 2px rgba(36, 41, 47, 0.025), 0 12px 30px rgba(36, 41, 47, 0.035);
    color: inherit;
    text-decoration: none !important;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .ability-map-card::before {
    position: absolute;
    top: 0;
    right: 1.15rem;
    left: 1.15rem;
    height: 0.16rem;
    border-radius: 0 0 999px 999px;
    background: var(--map-accent);
    content: '';
    opacity: 0.84;
  }

  .ability-map-card.system {
    --map-accent: #2d8b69;
    --map-wash: #dff3e9;
  }

  .ability-map-card.agent {
    --map-accent: #7a5db0;
    --map-wash: #eee8f8;
  }

  .ability-map-card:hover {
    border-color: color-mix(in srgb, var(--map-accent) 42%, var(--sl-color-gray-5));
    box-shadow: 0 2px 5px rgba(36, 41, 47, 0.035), 0 16px 34px rgba(36, 41, 47, 0.055);
    transform: translateY(-2px);
  }

  .ability-map-card:focus-visible {
    outline: 2px solid var(--map-accent);
    outline-offset: 3px;
  }

  .ability-map-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .ability-map-title {
    color: var(--sl-color-white);
    font-family: var(--sl-font-heading);
    font-size: 1.02rem;
    font-weight: 650;
    line-height: 1.3;
  }

  .ability-map-arrow {
    width: 1.1rem;
    height: 1.1rem;
    flex: 0 0 auto;
    fill: none;
    stroke: var(--map-accent);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.75;
    transition: transform 180ms ease;
  }

  .ability-map-card:hover .ability-map-arrow {
    transform: translateX(0.18rem);
  }

  .ability-map-desc {
    display: block;
    min-height: 2.7em;
    margin-top: 0.48rem;
    color: var(--sl-color-gray-2);
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .ability-map-route {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 1.35rem;
  }

  .ability-map-route::before {
    position: absolute;
    top: 0.52rem;
    right: calc(16.666% - 0.18rem);
    left: calc(16.666% - 0.18rem);
    height: 1px;
    background: color-mix(in srgb, var(--map-accent) 38%, var(--sl-color-gray-5));
    content: '';
  }

  .ability-map-route span {
    position: relative;
    color: var(--sl-color-gray-2);
    font-size: 0.65rem;
    line-height: 1.35;
    text-align: center;
  }

  .ability-map-route span::before {
    position: absolute;
    top: -1.05rem;
    left: calc(50% - 0.22rem);
    width: 0.44rem;
    height: 0.44rem;
    border: 2px solid color-mix(in srgb, var(--map-accent) 72%, white);
    border-radius: 50%;
    background: var(--sl-color-bg);
    box-shadow: 0 0 0 0.2rem color-mix(in srgb, var(--map-wash) 65%, transparent);
    content: '';
  }

  .ability-map-stats {
    display: block;
    margin-top: 0.95rem;
    padding-top: 0.72rem;
    border-top: 1px solid color-mix(in srgb, var(--map-accent) 14%, var(--sl-color-gray-5));
    color: color-mix(in srgb, var(--map-accent) 78%, var(--sl-color-gray-1));
    font-family: var(--sl-font-utility);
    font-size: 0.67rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .home-sections {
    display: grid;
    gap: 0.72rem;
    margin: 0 0 2.5rem;
  }

  .section-card {
    display: grid;
    grid-template-columns: 0.25rem minmax(11rem, 0.7fr) minmax(0, 1.8fr);
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2.5rem);
    margin: 0;
    padding: 1.15rem 1.35rem;
    background: color-mix(in srgb, var(--sl-color-surface) 66%, var(--sl-color-bg));
    border-radius: 0.85rem;
    box-shadow: 0 1px 2px rgba(36, 41, 47, 0.022), 0 10px 28px rgba(36, 41, 47, 0.028);
    animation: sectionFadeIn 0.4s ease-out both;
    transition: background-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .section-card:hover {
    background: color-mix(in srgb, var(--sl-color-surface) 82%, var(--sl-color-bg));
    box-shadow: 0 2px 4px rgba(36, 41, 47, 0.025), 0 14px 32px rgba(36, 41, 47, 0.04);
    transform: translateY(-1px);
  }

  .section-accent {
    align-self: start;
    width: 0.25rem;
    height: 1.35rem;
    margin-top: 0.15rem;
    border-radius: 999px;
    background: #3f78e6;
  }

  .section-header {
    display: block;
    min-width: 0;
    text-decoration: none !important;
    color: inherit;
  }

  .section-title-row {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
  }

  .section-header:hover .section-title {
    color: #2458c6;
  }

  .section-title {
    display: block;
    font-family: var(--sl-font-heading);
    font-size: clamp(1.18rem, 1.65vw, 1.42rem);
    font-weight: 600;
    color: var(--sl-color-white);
    margin: 0;
    line-height: 1.2;
    letter-spacing: 0;
    transition: color 0.2s ease;
  }

  .section-desc {
    display: block;
    max-width: 19rem;
    margin-top: 0.35rem;
    color: var(--sl-color-gray-2);
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .section-count {
    display: block;
    margin-top: 0.5rem;
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-utility);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.03em;
  }

  .section-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(1.25rem, 3vw, 3.25rem);
  }

  .section-list > .section-item {
    margin: 0;
    padding: 0;
  }

  .section-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.7rem;
    margin: 0 -0.35rem;
    padding: 0.31rem 0.35rem;
    text-decoration: none !important;
    color: var(--sl-color-gray-1);
    border-radius: 0.35rem;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .section-link:hover {
    color: #2458c6;
    background: color-mix(in srgb, #dfe9fb 42%, transparent);
  }

  .section-link:hover time {
    color: #2458c6;
  }

  .section-link-title {
    min-width: 0;
    font-family: var(--sl-font);
    font-size: 0.85rem;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: 0;
    font-synthesis: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .section-link time {
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-utility);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
  }

  .section-link:focus-visible,
  .section-header:focus-visible {
    border-radius: 3px;
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 3px;
  }

  @keyframes sectionFadeIn {
    from {
      opacity: 0;
      transform: translateY(0.35rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-card { animation: none; }
    .ability-map-card,
    .ability-map-arrow { transition: none; }
  }

  @media (max-width: 800px) {
    .ability-map-grid {
      grid-template-columns: 1fr;
    }

    .ability-map-card {
      min-height: 11.75rem;
    }

    .section-card {
      grid-template-columns: 0.25rem minmax(8.5rem, 0.72fr) minmax(0, 1.4fr);
      gap: 0.9rem;
      padding: 1rem;
    }

