    href: '/security/1-zero-day-vulnerability-primer/',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2l1.5 2h5L16 2"/><rect x="5" y="4" width="14" height="16" rx="7"/><path d="M2 9h3M19 9h3M2 15h3M19 15h3M9 9h6M9 13h6M12 13v5"/></svg>',
  },
];

const allDocs = await getCollection('docs');

function parseDateFromFilename(id: string): Date | null {
  if (typeof id !== 'string') return null;
  const match = id.match(/(\d{4}-\d{2}-\d{2})/);
  if (match) return new Date(match[1]);
  return null;
}

function getFilenameOrder(id: string): number {
  if (typeof id !== 'string') return 0;
  const numMatch = id.match(/\/(\d{1,2})-/);
  return numMatch ? parseInt(numMatch[1], 10) : 0;
}

function getDocDate(doc: typeof allDocs[number]): number {
  if (doc.data.lastUpdated) return new Date(doc.data.lastUpdated).getTime();
  if (doc.data.date) return new Date(doc.data.date).getTime();
  const parsed = parseDateFromFilename(doc.id);
  if (parsed) return parsed.getTime();
  return 0;
}

function isArticle(doc: typeof allDocs[number]) {
  const id = doc.id;
  return Boolean(id && !id.endsWith('index') && !id.includes('_category_') && id !== 'index.mdx');
}

function getCategoryDocs(categoryId: string, count = 5) {
  return allDocs
    .filter((doc) => {
      if (!isArticle(doc)) return false;
      return doc.id.startsWith(`${categoryId}/`);
    })
    .sort((a, b) => {
      const dateDiff = getDocDate(b) - getDocDate(a);
      if (dateDiff !== 0) return dateDiff;
      return getFilenameOrder(b) - getFilenameOrder(a);
    })
    .slice(0, count);
}

const sections = categories.map((cat) => ({
  ...cat,
  docs: getCategoryDocs(cat.id),
  count: allDocs.filter((doc) => isArticle(doc) && doc.id.startsWith(`${cat.id}/`)).length,
}));

const compactDateFormatter = new Intl.DateTimeFormat('zh-CN', {
  month: '2-digit',
  day: '2-digit',
});

function formatDate(doc: typeof allDocs[number]) {
  const value = doc.data.lastUpdated || doc.data.date;
  if (!value) return '';
  return compactDateFormatter.format(new Date(value)).replace('/', '.');
}
---

<header class="directory-toolbar">
  <strong class="directory-label">全部专栏</strong>
  <a class="knowledge-map-entry" href="/agent-knowledge/">
    <svg aria-hidden="true" viewBox="0 0 24 24">
      <circle cx="6" cy="7" r="2.2" />
      <circle cx="18" cy="7" r="2.2" />
      <circle cx="12" cy="17" r="2.2" />
      <path d="m7.9 8.2 2.7 6.4m5.5-6.4-2.7 6.4M8.2 7h7.6" />
    </svg>
    <span>
      <strong>Agent 学习地图</strong>
      <small>{knowledgeData.meta.pointCount} 个知识点</small>
    </span>
    <i aria-hidden="true">→</i>
  </a>
</header>

<div class="home-sections" aria-label="文章分栏">
  {
    sections.map((cat) => (
      <section class="section-card" aria-labelledby={`section-${cat.id}`}>
        <span class="section-accent" aria-hidden="true"></span>

        <a href={cat.href} class="section-header">
          <span class="section-title-row">
            <span class="section-title" id={`section-${cat.id}`}>{cat.title}</span>
          </span>
          <span class="section-desc">{cat.desc}</span>
          <span class="section-count">{cat.count} 篇文章</span>
        </a>

        {cat.docs.length > 0 && (
          <ul class="section-list">
            {cat.docs.map((doc) => {
              const href = `/${doc.id.replace(/\.mdx?$/, '').replace(/\/index$/, '/')}/`;
              return (
                <li class="section-item">
                  <a href={href} class="section-link">
                    <span class="section-link-title">{doc.data.title}</span>
                    <time datetime={new Date(doc.data.lastUpdated || doc.data.date || 0).toISOString()}>{formatDate(doc)}</time>
                  </a>
                </li>
              );
            })}
          </ul>
        )}
      </section>
    ))
  }
</div>

<style>
  .directory-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 3.25rem;
    margin: 0.75rem 0 0.85rem;
  }

  .directory-label {
    color: var(--sl-color-gray-1);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .knowledge-map-entry {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 3rem;
    padding: 0.48rem 0.62rem 0.48rem 0.78rem;
    overflow: hidden;
    color: var(--sl-color-gray-1);
    background: color-mix(in srgb, var(--sl-color-surface) 76%, var(--sl-color-bg));
    border: 0;
    border-radius: 0.85rem;
    line-height: 1;
    text-decoration: none !important;
    text-decoration-line: none !important;
    box-shadow: inset 0.22rem 0 #3f78e6, 0 1px 2px rgba(36, 41, 47, 0.022), 0 10px 28px rgba(36, 41, 47, 0.04);
    animation: mapEntryIn 0.42s ease-out backwards;
    transition: color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .knowledge-map-entry > svg {
    width: 2rem;
    height: 2rem;
    padding: 0.4rem;
    flex: 0 0 auto;
    fill: none;
    stroke: #3f78e6;
    stroke-width: 1.55;
    stroke-linecap: round;
    border-radius: 0.58rem;
    background: color-mix(in srgb, #e6edfb 76%, var(--sl-color-surface));
  }

  .knowledge-map-entry > svg path {
    stroke-dasharray: 24;
    stroke-dashoffset: 0;
  }

  .knowledge-map-entry > svg circle {
    transform-box: fill-box;
    transform-origin: center;
  }

  .knowledge-map-entry > span {
    display: grid;
    gap: 0.25rem;
  }

  .knowledge-map-entry strong {
    color: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none !important;
  }

  .knowledge-map-entry small {
    color: var(--sl-color-gray-2);
    font-size: 0.64rem;
    font-weight: 450;
  }

  .knowledge-map-entry i {
    display: grid;
    width: 1.65rem;
    height: 1.65rem;
    border-radius: 999px;
    background: transparent;
    color: #356bd2;
    font-size: 0.82rem;
    font-style: normal;
    place-items: center;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .knowledge-map-entry:hover {
    color: #2458c6;
    background: color-mix(in srgb, var(--sl-color-surface) 92%, #e6edfb);
    text-decoration: none !important;
    text-decoration-line: none !important;
    box-shadow: inset 0.22rem 0 #3f78e6, 0 2px 4px rgba(36, 41, 47, 0.025), 0 14px 32px rgba(36, 41, 47, 0.055);
    transform: translateY(-1px);
  }

  .knowledge-map-entry:hover i {
    background: color-mix(in srgb, #3f78e6 10%, transparent);
    transform: translateX(0.12rem);
  }

  .knowledge-map-entry:is(:hover, :focus-visible) > svg path {
    animation: mapTrace 0.5s ease-out both;
  }

  .knowledge-map-entry:is(:hover, :focus-visible) > svg circle {
    animation: mapNodePulse 0.42s ease-out both;
  }

  .knowledge-map-entry:is(:hover, :focus-visible) > svg circle:nth-child(2) { animation-delay: 0.08s; }
  .knowledge-map-entry:is(:hover, :focus-visible) > svg circle:nth-child(3) { animation-delay: 0.16s; }

  @keyframes mapTrace {
    from { stroke-dashoffset: 24; }
    to { stroke-dashoffset: 0; }
  }

  @keyframes mapNodePulse {
    0%, 100% { transform: scale(1); }
    48% { transform: scale(1.28); }
  }

  @keyframes mapEntryIn {
    from { opacity: 0; transform: translateY(0.28rem); }
    to { opacity: 1; transform: translateY(0); }
  }

  .home-sections {
    display: grid;
    gap: 0.72rem;
    margin: 0 0 2.5rem;
  }

  .section-card {
    display: grid;
    grid-template-columns: 0.25rem minmax(11rem, 0.7fr) minmax(0, 1.8fr);
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2.5rem);
    margin: 0;
    padding: 1.15rem 1.35rem;
    background: color-mix(in srgb, var(--sl-color-surface) 66%, var(--sl-color-bg));
    border-radius: 0.85rem;
    box-shadow: 0 1px 2px rgba(36, 41, 47, 0.022), 0 10px 28px rgba(36, 41, 47, 0.028);
    animation: sectionFadeIn 0.4s ease-out both;
    transition: background-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .section-card:hover {
    background: color-mix(in srgb, var(--sl-color-surface) 82%, var(--sl-color-bg));
    box-shadow: 0 2px 4px rgba(36, 41, 47, 0.025), 0 14px 32px rgba(36, 41, 47, 0.04);
    transform: translateY(-1px);
  }

  .section-accent {
    align-self: start;
    width: 0.25rem;
    height: 1.35rem;
    margin-top: 0.15rem;
    border-radius: 999px;
    background: #3f78e6;
  }

  .section-header {
    display: block;
    min-width: 0;
    text-decoration: none !important;
    color: inherit;
  }

  .section-title-row {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
  }

  .section-header:hover .section-title {
    color: #2458c6;
  }

  .section-title {
    display: block;
    font-family: var(--sl-font-heading);
    font-size: clamp(1.18rem, 1.65vw, 1.42rem);
    font-weight: 600;
    color: var(--sl-color-white);
    margin: 0;
    line-height: 1.2;
    letter-spacing: 0;
    transition: color 0.2s ease;
  }

  .section-desc {
    display: block;
    max-width: 19rem;
    margin-top: 0.35rem;
    color: var(--sl-color-gray-2);
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .section-count {
    display: block;
    margin-top: 0.5rem;
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-utility);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.03em;
  }

  .section-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(1.25rem, 3vw, 3.25rem);
  }

  .section-list > .section-item {
    margin: 0;
    padding: 0;
  }

  .section-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.7rem;
    margin: 0 -0.35rem;
    padding: 0.31rem 0.35rem;
    text-decoration: none !important;
    color: var(--sl-color-gray-1);
    border-radius: 0.35rem;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .section-link:hover {
    color: #2458c6;
    background: color-mix(in srgb, #dfe9fb 42%, transparent);
  }

  .section-link:hover time {
    color: #2458c6;
  }

  .section-link-title {
    min-width: 0;
    font-family: var(--sl-font);
    font-size: 0.85rem;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: 0;
    font-synthesis: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .section-link time {
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-utility);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
  }

  .section-link:focus-visible,
  .section-header:focus-visible {
    border-radius: 3px;
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 3px;
  }

  @keyframes sectionFadeIn {
    from {
      opacity: 0;
      transform: translateY(0.35rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-card,
    .knowledge-map-entry,
    .knowledge-map-entry > svg path,
    .knowledge-map-entry > svg circle {
      animation: none;
    }

    .knowledge-map-entry,
    .knowledge-map-entry i {
      transition: none;
    }
  }

  @media (max-width: 800px) {
    .section-card {
      grid-template-columns: 0.25rem minmax(8.5rem, 0.72fr) minmax(0, 1.4fr);
      gap: 0.9rem;
      padding: 1rem;
    }

    .section-list {
      grid-template-columns: 1fr;
    }

    .section-item:nth-child(n + 4) {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .directory-toolbar {
      margin-top: 0.45rem;
      gap: 1rem;
    }

    .knowledge-map-entry {
      min-height: 2.5rem;
    }

    .section-card {
      grid-template-columns: 0.25rem minmax(0, 1fr);
      gap: 0.8rem;
      padding: 1rem;
    }

    .section-header {
      padding-right: 0.25rem;
    }

    .section-list {
      grid-column: 2;
      margin-top: 0.15rem;
    }

    .section-count {
      margin-top: 0.5rem;
    }
  }
</style>
