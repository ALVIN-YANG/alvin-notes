---
import type { Props } from '@astrojs/starlight/props';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
  { label: 'AI Agent', href: '/agent-knowledge/', match: '/agent-knowledge/' },
  { label: 'AI 工作流', href: '/ai-workflow/ai-coding-skills-selection-guide/', match: '/ai-workflow/' },
  { label: 'Skills', href: '/skills/', match: '/skills/' },
  { label: '系统设计', href: '/system-design-knowledge/', match: '/system-design-knowledge/' },
  { label: 'OpenClaw', href: '/claw/openclaw/', match: '/claw/' },
  { label: 'AI News', href: '/ai-news/', match: '/ai-news/' },
  { label: '算法', href: '/algorithm-knowledge/', match: '/algorithm-knowledge/' },
  { label: '网络', href: '/network/ai-agent-communication-protocols/', match: '/network/' },
  { label: '安全', href: '/security/1-zero-day-vulnerability-primer/', match: '/security/' },
  { label: '模型榜', href: '/model-arena', match: '/model-arena' },
  { label: 'Ops', href: '/ops/k8s/kubernetes-practical-starter-guide/', match: '/ops/' },
  { label: '关于', href: '/about/', match: '/about/' },
];

const currentPath = Astro.url.pathname;

function isActive(match: string): boolean {
  if (match === '/') return currentPath === '/';
  if (match === '/algorithm-knowledge/') {
    return currentPath.startsWith('/algorithm-knowledge/')
      || currentPath.startsWith('/algorithms/')
      || currentPath.startsWith('/java/');
  }
  if (match === '/system-design-knowledge/') {
    return currentPath.startsWith('/system-design-knowledge/') || currentPath.startsWith('/architecture/');
  }
  if (match === '/agent-knowledge/') {
    return currentPath.startsWith('/agent-knowledge/') || currentPath.startsWith('/ai/');
  }
  if (match === '/ai-workflow/') return currentPath.startsWith('/ai-workflow/');
  return currentPath.startsWith(match);
}
---

<div class="header sl-flex">
  <div class="title-wrapper sl-flex">
    <SiteTitle {...Astro.props} />
  </div>
  <div class="sl-flex spacer"></div>
  <nav class="sl-flex nav-links">
    {navLinks.map(link => (
      <a href={link.href} class:list={[{ active: isActive(link.match) }]}>{link.label}</a>
    ))}
  </nav>
  <div class="sl-flex right-group-mobile md:sl-hidden">
    <button
      class="mobile-nav-trigger"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav-panel"
      aria-label="打开栏目导航"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
        <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
      <span>栏目</span>
    </button>
    <ThemeToggle />
  </div>
  <div id="mobile-nav-panel" class="mobile-nav-panel" hidden>
    <nav aria-label="全部栏目">
      {navLinks.map(link => (
        <a href={link.href} class:list={[{ active: isActive(link.match) }]}>{link.label}</a>
      ))}
    </nav>
  </div>
  <div class="sl-hidden md:sl-flex right-group">
    <Search {...Astro.props} />
    <div class="sl-flex social-icons">
      <SocialIcons {...Astro.props} />
    </div>
    <ThemeToggle />
  </div>
</div>

<reading-progress aria-hidden="true" hidden>
  <span></span>
</reading-progress>

<style>
  .header {
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: 100%;
    position: relative;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .title-wrapper {
    overflow: hidden;
  }
  :global(.site-title) {
    font-family: var(--sl-font-heading) !important;
    font-size: 1.45rem !important;
    font-weight: 600 !important;
    letter-spacing: -0.02em;
  }
  .right-group {
    gap: 1rem;
    align-items: center;
  }
  .social-icons {
    gap: 1rem;
    align-items: center;
  }

  /* ── Desktop Nav ── */
  .nav-links {
    gap: 0.1rem;
    align-items: center;
    display: none;
    flex-wrap: wrap;
    justify-content: center;
  }
  @media (min-width: 50rem) {
    .nav-links {
      display: flex;
    }
  }
  .nav-links a {
    text-decoration: none;
    color: var(--sl-color-gray-2);
    font-weight: 500;
    font-size: 0.8rem;
    padding: 0.2rem 0.4rem;
    border-radius: 6px;
    white-space: nowrap;
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .nav-links a:hover {
    color: var(--sl-color-white);
    background-color: var(--sl-color-accent-low);
  }
  .nav-links a.active {
    color: var(--sl-color-accent-high);
    background-color: #e7e6dc;
  }
  reading-progress {
    position: absolute;
    inset-inline: 0;
    inset-block-end: -1px;
    display: block;
    height: 2px;
    overflow: hidden;
    pointer-events: none;
  }

  reading-progress[hidden] {
    display: none;
  }

  reading-progress span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--sl-color-accent);
    transform: scaleX(0);
    transform-origin: left center;
    will-change: transform;
  }

  /* ── Mobile right group ── */
  .right-group-mobile {
    align-items: center;
    gap: 0.5rem;
  }

  .mobile-nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    background: var(--sl-color-surface);
    color: var(--sl-color-gray-1);
    font-size: 0.78rem;
    font-weight: 500;
    cursor: pointer;
  }

  .mobile-nav-trigger[aria-expanded='true'] {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent-high);
    background: var(--sl-color-accent-low);
  }

  .mobile-nav-panel {
    position: absolute;
    inset-inline: 0.75rem;
    top: calc(var(--sl-nav-height) + 0.35rem);
    z-index: 20;
    padding: 0.65rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
    background: var(--sl-color-bg-nav);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 12px 32px rgba(36, 41, 47, 0.12);
  }

  .mobile-nav-panel[hidden] {
    display: none;
  }

  .mobile-nav-panel nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.35rem;
  }

  .mobile-nav-panel a {
    display: block;
    padding: 0.55rem 0.7rem;
    border-radius: 8px;
    color: var(--sl-color-gray-1);
    font-size: 0.86rem;
    font-weight: 500;
    text-decoration: none;
  }

  .mobile-nav-panel a:hover,
  .mobile-nav-panel a.active {
    color: var(--sl-color-accent-high);
    background: var(--sl-color-accent-low);
  }

  @media (min-width: 50rem) {
    .mobile-nav-trigger,
    .mobile-nav-panel {
      display: none !important;
    }
  }
</style>

<script>
  class ReadingProgress extends HTMLElement {
    abortController = new AbortController();
    article: HTMLElement | null = null;
    bar: HTMLElement | null = null;
    frame = 0;

    connectedCallback() {
      if (document.documentElement.hasAttribute('data-has-hero')) return;

      this.article = document.querySelector('main .sl-markdown-content');
      this.bar = this.querySelector('span');
      if (!this.article || !this.bar) return;

      this.hidden = false;
      const signal = this.abortController.signal;
      window.addEventListener('scroll', this.scheduleUpdate, { passive: true, signal });
      window.addEventListener('resize', this.scheduleUpdate, { passive: true, signal });
      this.scheduleUpdate();
    }

    disconnectedCallback() {
      this.abortController.abort();
      window.cancelAnimationFrame(this.frame);
    }

    scheduleUpdate = () => {
      if (this.frame) return;
      this.frame = window.requestAnimationFrame(this.renderProgress);
    };

    renderProgress = () => {
      this.frame = 0;
      if (!this.article || !this.bar) return;

      const articleTop = window.scrollY + this.article.getBoundingClientRect().top;
      const start = articleTop - 120;
      const end = articleTop + this.article.offsetHeight - window.innerHeight * 0.72;
      const progress = end <= start ? 1 : (window.scrollY - start) / (end - start);
      const clamped = Math.min(1, Math.max(0, progress));
      this.bar.style.transform = `scaleX(${clamped})`;
    };
  }

  if (!customElements.get('reading-progress')) {
    customElements.define('reading-progress', ReadingProgress);
  }

  const mobileTrigger = document.querySelector<HTMLButtonElement>('.mobile-nav-trigger');
  const mobilePanel = document.getElementById('mobile-nav-panel');

  function closeMobileNav() {
    if (!mobileTrigger || !mobilePanel) return;
    mobileTrigger.setAttribute('aria-expanded', 'false');
    mobileTrigger.setAttribute('aria-label', '打开栏目导航');
    mobilePanel.hidden = true;
  }

  mobileTrigger?.addEventListener('click', () => {
    if (!mobilePanel) return;
    const open = mobileTrigger.getAttribute('aria-expanded') === 'true';
    mobileTrigger.setAttribute('aria-expanded', String(!open));
    mobileTrigger.setAttribute('aria-label', open ? '打开栏目导航' : '关闭栏目导航');
    mobilePanel.hidden = open;
  });

  mobilePanel?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMobileNav);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMobileNav();
  });

  document.addEventListener('click', (event) => {
    if (!mobilePanel || mobilePanel.hidden) return;
    const target = event.target as Node;
    if (mobilePanel.contains(target) || mobileTrigger?.contains(target)) return;
    closeMobileNav();
  });
</script>
