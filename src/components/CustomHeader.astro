---
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeToggle from './ThemeToggle.astro';
import { bookStartUrl } from '../data/agent-book-links.mjs';

const navGroups = [
  {
    label: 'AI 工程',
    links: [
      { label: 'AI Agent', href: bookStartUrl, match: '/agent-knowledge/' },
      { label: 'AI Infra', href: '/ai-infra-knowledge/', match: '/ai-infra' },
      { label: 'RAG 实战', href: '/rag/', match: '/rag/' },
      { label: 'AI 概念', href: '/ai-concepts/', match: '/ai-concepts/' },
      { label: 'AI 工程问答', href: '/interview/', match: '/interview/' },
    ],
  },
  {
    label: '开发实践',
    links: [
      { label: 'AI 工作流', href: '/ai-workflow/', match: '/ai-workflow/' },
      { label: 'Skills', href: '/skills/', match: '/skills/' },
      { label: '工具箱', href: '/tools/', match: '/tools/' },
      { label: '游戏攻略', href: '/projects/game-guides/', match: '/projects/game-guides/' },
    ],
  },
  {
    label: '工程基础',
    links: [
      { label: '系统设计', href: '/system-design/', match: '/system-design/' },
      { label: '凤凰架构', href: '/phoenix/', match: '/phoenix/' },
      { label: '算法', href: '/algorithm-knowledge/', match: '/algorithm-knowledge/' },
      { label: '网络', href: '/network/ai-agent-communication-protocols/', match: '/network/' },
      { label: '安全', href: '/security/1-zero-day-vulnerability-primer/', match: '/security/' },
      { label: 'Ops', href: '/ops/k8s/kubernetes-practical-starter-guide/', match: '/ops/' },
    ],
  },
  {
    label: '行业观察',
    links: [
      { label: 'AI News', href: '/ai-news/', match: '/ai-news/' },
      { label: '公司观察', href: '/companies/', match: '/companies/' },
      { label: '人物志', href: '/people/', match: '/people/' },
      { label: '模型榜', href: '/model-arena', match: '/model-arena' },
    ],
  },
];

const directLinks = [
  { label: '职业手册', href: '/career/', match: '/career/' },
  { label: '作品', href: '/projects/', match: '/projects/' },
  { label: '关于', href: '/about/', match: '/about/' },
];

const currentPath = Astro.url.pathname;

function isActive(match: string): boolean {
  if (match === '/') return currentPath === '/';
  if (match === '/algorithm-knowledge/') {
    return currentPath.startsWith('/algorithm-knowledge/')
      || currentPath.startsWith('/algorithms/')
      || currentPath.startsWith('/java/');
  }
  if (match === '/system-design/') {
    return currentPath.startsWith('/system-design/') || currentPath.startsWith('/architecture/');
  }
  if (match === '/agent-knowledge/') {
    return currentPath.startsWith('/agent-knowledge/')
      || currentPath.startsWith('/ai/')
      || currentPath.startsWith('/claw/');
  }
  if (match === '/ai-workflow/') return currentPath.startsWith('/ai-workflow/');
  return currentPath.startsWith(match);
}
---

<div class="site-header sl-flex">
  <div class="title-wrapper sl-flex">
    <SiteTitle {...Astro.props} />
  </div>
  <nav class="nav-links" aria-label="主导航">
    {navGroups.map(group => (
      <details class="nav-dropdown">
        <summary class:list={[{ active: group.links.some(link => isActive(link.match)) }]}>
          {group.label}<svg class="nav-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
        </summary>
        <div class="nav-dropdown-panel">
          {group.links.map(link => (
            <a href={link.href} class:list={[{ active: isActive(link.match) }]} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>
          ))}
        </div>
      </details>
    ))}
    {directLinks.map(link => (
      <a href={link.href} class:list={[{ active: isActive(link.match) }]} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>
    ))}
  </nav>
  <div class="sl-flex right-group-mobile">
    <button
      class="mobile-nav-trigger"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav-panel"
      aria-label="打开栏目导航"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
        <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
      <span>栏目</span>
    </button>
    <ThemeToggle />
  </div>
  <div id="mobile-nav-panel" class="mobile-nav-panel" hidden>
    <nav aria-label="全部栏目">
      {navGroups.map(group => (
        <section class="mobile-nav-group" aria-label={group.label}>
          <h2>{group.label}</h2>
          <div>
            {group.links.map(link => (
              <a href={link.href} class:list={[{ active: isActive(link.match) }]} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>
            ))}
          </div>
        </section>
      ))}
      <div class="mobile-nav-direct">
        {directLinks.map(link => (
          <a href={link.href} class:list={[{ active: isActive(link.match) }]} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>
        ))}
      </div>
    </nav>
  </div>
  <div class="sl-flex right-group">
    {(currentPath.startsWith('/system-design/') || currentPath.startsWith('/phoenix/')) ? <button type="button" disabled class="primer-search-open" data-primer-search-trigger>搜索文档 <kbd>⌘ K</kbd></button> : <Search {...Astro.props} />}
    <div class="sl-flex social-icons">
      <SocialIcons {...Astro.props} />
    </div>
    <ThemeToggle />
  </div>
</div>

<reading-progress aria-hidden="true" hidden>
  <span></span>
</reading-progress>

<style>
  reading-progress {
    position: absolute;
    inset-inline: 0;
    inset-block-end: -1px;
    display: block;
    height: 2px;
    overflow: hidden;
    pointer-events: none;
  }

  reading-progress[hidden] {
    display: none;
  }

  reading-progress span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--sl-color-accent);
    transform: scaleX(0);
    transform-origin: left center;
    will-change: transform;
  }

</style>

<script>
  class ReadingProgress extends HTMLElement {
    abortController = new AbortController();
    article: HTMLElement | null = null;
    bar: HTMLElement | null = null;
    frame = 0;

    connectedCallback() {
      if (document.documentElement.hasAttribute('data-has-hero')) return;

      this.article = document.querySelector('main .sl-markdown-content');
      this.bar = this.querySelector('span');
      if (!this.article || !this.bar) return;

      this.hidden = false;
      const signal = this.abortController.signal;
      window.addEventListener('scroll', this.scheduleUpdate, { passive: true, signal });
      window.addEventListener('resize', this.scheduleUpdate, { passive: true, signal });
      this.scheduleUpdate();
    }

    disconnectedCallback() {
      this.abortController.abort();
      window.cancelAnimationFrame(this.frame);
    }

    scheduleUpdate = () => {
      if (this.frame) return;
      this.frame = window.requestAnimationFrame(this.renderProgress);
    };

    renderProgress = () => {
      this.frame = 0;
      if (!this.article || !this.bar) return;

      const articleTop = window.scrollY + this.article.getBoundingClientRect().top;
      const start = articleTop - 120;
      const end = articleTop + this.article.offsetHeight - window.innerHeight * 0.72;
      const progress = end <= start ? 1 : (window.scrollY - start) / (end - start);
      const clamped = Math.min(1, Math.max(0, progress));
      this.bar.style.transform = `scaleX(${clamped})`;
    };
  }

  if (!customElements.get('reading-progress')) {
    customElements.define('reading-progress', ReadingProgress);
  }

  const mobileTrigger = document.querySelector<HTMLButtonElement>('.mobile-nav-trigger');
  const mobilePanel = document.getElementById('mobile-nav-panel');

  function closeMobileNav() {
    if (!mobileTrigger || !mobilePanel) return;
    mobileTrigger.setAttribute('aria-expanded', 'false');
    mobileTrigger.setAttribute('aria-label', '打开栏目导航');
    mobilePanel.hidden = true;
  }

  window.matchMedia('(min-width: 64rem)').addEventListener('change', closeMobileNav);

  mobileTrigger?.addEventListener('click', () => {
    if (!mobilePanel) return;
    const open = mobileTrigger.getAttribute('aria-expanded') === 'true';
    mobileTrigger.setAttribute('aria-expanded', String(!open));
    mobileTrigger.setAttribute('aria-label', open ? '打开栏目导航' : '关闭栏目导航');
    mobilePanel.hidden = open;
  });

  mobilePanel?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMobileNav);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobilePanel && !mobilePanel.hidden) {
      closeMobileNav();
      mobileTrigger?.focus();
    }
  });

  document.addEventListener('click', (event) => {
    if (!mobilePanel || mobilePanel.hidden) return;
    const target = event.target as Node;
    if (mobilePanel.contains(target) || mobileTrigger?.contains(target)) return;
    closeMobileNav();
  });

  const dropdowns = [...document.querySelectorAll<HTMLDetailsElement>('.nav-dropdown')];
  dropdowns.forEach((dropdown) => {
    dropdown.addEventListener('toggle', () => {
      if (dropdown.open) dropdowns.forEach((other) => {
        if (other !== dropdown) other.open = false;
      });
    });
    dropdown.addEventListener('focusout', (event) => {
      if (!dropdown.contains(event.relatedTarget as Node | null)) dropdown.open = false;
    });
  });

  document.addEventListener('click', (event) => {
    dropdowns.forEach((dropdown) => {
      if (!dropdown.contains(event.target as Node)) dropdown.open = false;
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    dropdowns.forEach((dropdown) => {
      if (!dropdown.open) return;
      dropdown.open = false;
      dropdown.querySelector('summary')?.focus();
    });
  });
</script>
