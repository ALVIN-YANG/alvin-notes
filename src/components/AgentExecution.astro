---
const nodes = [
  { id: 'task', label: '输入目标', code: 'TASK' },
  { id: 'context', label: '上下文', code: 'CONTEXT' },
  { id: 'planner', label: '任务规划', code: 'PLAN' },
  { id: 'model', label: 'LLM', code: 'INFERENCE' },
  { id: 'guard', label: '边界校验', code: 'GUARD' },
  { id: 'router', label: '工具路由', code: 'DISPATCH' },
  { id: 'world', label: '外部环境', code: 'WORLD' },
  { id: 'memory', label: '长期记忆', code: 'MEMORY' },
  { id: 'state', label: '工作状态', code: 'STATE' },
  { id: 'skills', label: 'Skills', code: 'POLICY' },
  { id: 'search', label: '搜索', code: 'SEARCH' },
  { id: 'terminal', label: '代码执行', code: 'TERMINAL' },
  { id: 'browser', label: '浏览器', code: 'BROWSER' },
  { id: 'observe', label: '观察结果', code: 'OBSERVE' },
  { id: 'evaluate', label: '结果评估', code: 'EVALUATE' },
  { id: 'output', label: '输出结果', code: 'DONE' },
];
const families: Record<string, string> = {
  task: 'context', context: 'context', memory: 'context', state: 'context',
  planner: 'reason', model: 'reason', guard: 'policy', skills: 'policy',
  router: 'tool', search: 'tool', terminal: 'tool', browser: 'tool', world: 'tool',
  observe: 'feedback', evaluate: 'feedback', output: 'feedback',
};
const edges = [
  ['input', 'task', 'context', 'right', 'left', 'context'],
  ['retrieve', 'memory', 'context', 'right', 'bottom', 'context'],
  ['plan', 'context', 'planner', 'right', 'left', 'reason'],
  ['infer', 'planner', 'model', 'right', 'left', 'reason'],
  ['working', 'model', 'state', 'bottom', 'right', 'context'],
  ['guard', 'model', 'guard', 'right', 'left', 'policy'],
  ['policy', 'skills', 'guard', 'right', 'bottom', 'policy'],
  ['dispatch', 'guard', 'router', 'right', 'left', 'tool'],
  ['search', 'router', 'search', 'bottom', 'top', 'tool'],
  ['terminal', 'router', 'terminal', 'bottom', 'top', 'tool'],
  ['browser', 'router', 'browser', 'bottom', 'top', 'tool'],
  ['search-result', 'search', 'world', 'right', 'bottom', 'tool'],
  ['terminal-result', 'terminal', 'world', 'right', 'bottom', 'tool'],
  ['browser-result', 'browser', 'world', 'right', 'bottom', 'tool'],
  ['observe', 'world', 'observe', 'bottom', 'top', 'feedback'],
  ['evaluate', 'observe', 'evaluate', 'left', 'right', 'feedback'],
  ['remember', 'evaluate', 'memory', 'top', 'left', 'context'],
  ['feedback', 'evaluate', 'context', 'left', 'left', 'feedback'],
  ['retry', 'evaluate', 'planner', 'left', 'left', 'reason'],
  ['finish', 'evaluate', 'output', 'left', 'right', 'feedback'],
];
---

<agent-execution class="agent-execution" data-phase="0" aria-label="Agent 编排与执行循环示意">
  <div class="ar-caption">
    <span class="ar-kicker"><span class="ar-caption-dot"></span>AGENT RUNTIME <small>执行示意</small></span>
    <span class="ar-status" aria-live="off"><span data-runtime-status>编排上下文</span></span>
  </div>
  <div class="ar-stage" data-runtime-stage role="img" aria-label="输入目标结合长期记忆组成上下文，经任务规划和模型推理，经过 Skills 与边界校验后路由到搜索、代码执行和浏览器。工具作用于环境，观察结果经评估后写入记忆、继续推理或重试；达到目标则输出结果。">
    <div class="ar-domain ar-domain-context" aria-hidden="true"><span>上下文</span></div>
    <div class="ar-domain ar-domain-reason" aria-hidden="true"><span>推理与约束</span></div>
    <div class="ar-domain ar-domain-tool" aria-hidden="true"><span>工具执行</span></div>
    <div class="ar-return-rail" aria-hidden="true"></div>
    <svg class="ar-wires" data-runtime-svg aria-hidden="true">
      <defs><marker id="runtime-arrow" markerWidth="5" markerHeight="5" refX="4" refY="2.5" orient="auto"><path d="m1 1 3 1.5L1 4" fill="none" stroke="context-stroke" stroke-width="1" /></marker></defs>
      {edges.map(([id, from, to, fromPort, toPort, kind]) => <path class="ar-wire" data-runtime-edge={id} data-from={from} data-to={to} data-from-port={fromPort} data-to-port={toPort} data-kind={kind} fill="none" marker-end="url(#runtime-arrow)" />)}
      {edges.map(([id, , , , , kind]) => [0, 1].map(sequence => <g class="ar-packet" data-runtime-packet={id} data-sequence={sequence} data-kind={kind} opacity="0"><path class="ar-packet-tail" d="M-9 0h6" /><circle class="ar-packet-halo" r="5" /><circle r="2" /></g>))}
    </svg>
    {nodes.map((node) => <span class={`ar-node ar-${node.id}`} data-runtime-node={node.id} data-family={families[node.id]} aria-hidden="true"><span class="ar-node-label">{node.label}</span><span class="ar-node-code">{node.code}</span><i class="ar-node-led"></i></span>)}
  </div>
  <div class="ar-footer" aria-hidden="true">
    <span data-family="context">上下文</span><span data-family="reason">推理</span><span data-family="policy">约束</span><span data-family="tool">执行</span><span data-family="feedback">反馈</span>
  </div>
</agent-execution>

<script>
  type Port = 'left' | 'right' | 'top' | 'bottom';
  type Point = { x: number; y: number };
  type Flight = { id: string; start: number; duration: number };
  class AgentExecution extends HTMLElement {
    private elapsed = 0;
    private lastTime = 0;
    private frame = 0;
    private visible = true;
    private initialized = false;
    private pendingLabel = '';
    private labelTimer = 0;
    private nodes = new Map<string, HTMLElement>();
    private paths = new Map<string, SVGPathElement>();
    private lengths = new Map<string, number>();
    private flights = new Map<string, Flight>();
    private packets: { element: SVGGElement; id: string; delay: number }[] = [];
    private markers: { time: number; label: string }[] = [];
    private cycle = 18000;
    private stage: HTMLElement | null = null;
    private svg: SVGSVGElement | null = null;
    private status: HTMLElement | null = null;
    private observer: IntersectionObserver | null = null;
    private resizeObserver: ResizeObserver | null = null;
    private motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    private abortController = new AbortController();

    connectedCallback() {
      if (this.initialized) return;
      this.initialized = true;
      this.stage = this.querySelector('[data-runtime-stage]');
      this.svg = this.querySelector('[data-runtime-svg]');
      this.status = this.querySelector('[data-runtime-status]');
      this.querySelectorAll<HTMLElement>('[data-runtime-node]').forEach(node => this.nodes.set(node.dataset.runtimeNode!, node));
      this.querySelectorAll<SVGPathElement>('[data-runtime-edge]').forEach(path => this.paths.set(path.dataset.runtimeEdge!, path));
      this.packets = [...this.querySelectorAll<SVGGElement>('[data-runtime-packet]')].map(element => ({ element, id: element.dataset.runtimePacket!, delay: Number(element.dataset.sequence) * 220 }));
      const { signal } = this.abortController;
      document.addEventListener('visibilitychange', this.sync, { signal });
      this.motion.addEventListener('change', this.sync, { signal });
      this.observer = new IntersectionObserver(([entry]) => { this.visible = entry.isIntersecting; this.sync(); });
      this.observer.observe(this);
      this.resizeObserver = new ResizeObserver(this.layout);
      if (this.stage) this.resizeObserver.observe(this.stage);
      this.layout();
      this.sync();
    }

    disconnectedCallback() {
      window.cancelAnimationFrame(this.frame);
      window.clearTimeout(this.labelTimer);
      this.observer?.disconnect();
      this.resizeObserver?.disconnect();
      this.abortController.abort();
    }

    private point(node: HTMLElement, port: Port, origin: DOMRect): Point {
      const rect = node.getBoundingClientRect();
      return { x: rect.left - origin.left + (port === 'left' ? 0 : port === 'right' ? rect.width : rect.width / 2), y: rect.top - origin.top + (port === 'top' ? 0 : port === 'bottom' ? rect.height : rect.height / 2) };
    }

    private layout = () => {
      if (!this.stage || !this.svg) return;
      const origin = this.stage.getBoundingClientRect();
      const compact = origin.width <= 560;
      this.svg.setAttribute('viewBox', `0 0 ${origin.width} ${origin.height}`);
      const directions: Record<Port, Point> = { left: { x: -1, y: 0 }, right: { x: 1, y: 0 }, top: { x: 0, y: -1 }, bottom: { x: 0, y: 1 } };
      this.paths.forEach((path, id) => {
        const from = this.nodes.get(path.dataset.from!);
        const to = this.nodes.get(path.dataset.to!);
        if (!from || !to) return;
        let fromPort = path.dataset.fromPort as Port;
        let toPort = path.dataset.toPort as Port;
        const centers = [this.point(from, 'top', origin), this.point(to, 'top', origin)];
        if (compact && Math.abs(centers[0].x - centers[1].x) < 2) {
          fromPort = centers[0].y < centers[1].y ? 'bottom' : 'top';
          toPort = centers[0].y < centers[1].y ? 'top' : 'bottom';
        }
        if (compact && ['search', 'terminal', 'browser'].includes(id)) { fromPort = 'left'; toPort = 'left'; }
        if (compact && id.endsWith('-result')) { fromPort = 'right'; toPort = 'right'; }
        if (id === 'feedback' || id === 'retry') { fromPort = 'left'; toPort = 'left'; }
        const a = this.point(from, fromPort, origin), b = this.point(to, toPort, origin);
        const distance = Math.max(4, Math.min(36, Math.hypot(a.x - b.x, a.y - b.y) * .35));
        const da = directions[fromPort], db = directions[toPort];
        let d = `M${a.x} ${a.y}C${a.x + da.x * distance} ${a.y + da.y * distance},${b.x + db.x * distance} ${b.y + db.y * distance},${b.x} ${b.y}`;
        if (Math.abs(a.y - b.y) < 1 || (Math.abs(a.x - b.x) < 1 && fromPort !== toPort)) d = `M${a.x} ${a.y}L${b.x} ${b.y}`;
        if (id === 'feedback' || id === 'retry' || (compact && ['search', 'terminal', 'browser'].includes(id))) {
          const lane = Math.min(a.x, b.x) - 8;
          const direction = b.y > a.y ? 1 : -1;
          d = `M${a.x} ${a.y}H${lane + 5}Q${lane} ${a.y} ${lane} ${a.y + direction * 5}V${b.y - direction * 5}Q${lane} ${b.y} ${lane + 5} ${b.y}H${b.x}`;
        }
        if (compact && id.endsWith('-result')) {
          const lane = Math.max(a.x, b.x) + 8;
          d = `M${a.x} ${a.y}H${lane - 5}Q${lane} ${a.y} ${lane} ${a.y + 5}V${b.y - 5}Q${lane} ${b.y} ${lane - 5} ${b.y}H${b.x}`;
        }
        if (id === 'remember') {
          const lane = Math.max(3, b.x - 8), rail = Math.min(a.y - 8, origin.height * .82);
          d = `M${a.x} ${a.y}V${rail + 5}Q${a.x} ${rail} ${a.x - 5} ${rail}H${lane + 5}Q${lane} ${rail} ${lane} ${rail - 5}V${b.y + 5}Q${lane} ${b.y} ${lane + 5} ${b.y}H${b.x}`;
        }
        if (id === 'working' && !compact) {
          const rail = origin.height * .80;
          d = `M${a.x} ${a.y}V${rail - 5}Q${a.x} ${rail} ${a.x - 5} ${rail}H${b.x + 8}Q${b.x + 3} ${rail} ${b.x + 3} ${rail - 5}V${b.y}H${b.x}`;
        }
        path.setAttribute('d', d);
        this.lengths.set(id, path.getTotalLength());
      });
      const fraction = (this.elapsed % this.cycle) / this.cycle;
      const rounds = Math.floor(this.elapsed / this.cycle);
      this.buildTimeline();
      this.elapsed = (rounds + fraction) * this.cycle;
      this.render();
    };

    private buildTimeline() {
      this.flights.clear();
      const add = (id: string, start: number) => {
        const duration = Math.max(650, Math.min(1800, (this.lengths.get(id) || 0) / .12));
        this.flights.set(id, { id, start, duration });
        return start + duration + 220;
      };
      const input = add('input', 200), retrieve = add('retrieve', 450);
      const context = Math.max(input, retrieve) + 180;
      const planned = add('plan', context);
      const inferred = add('infer', planned + 150);
      add('working', inferred + 100);
      const guarded = add('guard', inferred + 420), policy = add('policy', inferred + 200);
      const dispatched = add('dispatch', Math.max(guarded, policy) + 120);
      const searched = add('search', dispatched + 120), terminal = add('terminal', dispatched + 240), browser = add('browser', dispatched + 360);
      const results = [add('search-result', searched + 600), add('terminal-result', terminal + 600), add('browser-result', browser + 600)];
      const observationStart = Math.max(...results) + 120;
      const observed = add('observe', observationStart);
      const evaluated = add('evaluate', observed + 180);
      const remembered = add('remember', evaluated + 200);
      const end = Math.max(add('feedback', remembered + 150), add('retry', remembered + 150), add('finish', remembered + 150));
      this.cycle = end + 700;
      this.markers = [
        { time: 0, label: '编排上下文' }, { time: context, label: '规划 · 模型推理' },
        { time: inferred, label: 'Skills · 边界校验' }, { time: dispatched, label: '三路工具并行执行' },
        { time: observationStart, label: '环境反馈 · 观察结果' }, { time: observed, label: '结果评估 · 更新记忆' },
        { time: remembered, label: '回写上下文 · 继续循环' },
      ];
    }

    private sync = () => {
      window.cancelAnimationFrame(this.frame);
      this.lastTime = 0;
      this.dataset.motion = this.motion.matches ? 'reduced' : 'running';
      this.dataset.suspended = String(this.motion.matches || !this.visible || document.hidden);
      if (!this.motion.matches && this.visible && !document.hidden) this.frame = window.requestAnimationFrame(this.tick);
      else this.packets.forEach(packet => packet.element.setAttribute('opacity', '0'));
    };

    private tick = (time: number) => {
      if (this.motion.matches || !this.visible || document.hidden) { this.sync(); return; }
      if (this.lastTime) this.elapsed += Math.min(time - this.lastTime, 100);
      this.lastTime = time;
      this.render();
      this.frame = window.requestAnimationFrame(this.tick);
    };

    private setLabel(label: string) {
      if (!this.status || label === this.pendingLabel) return;
      this.pendingLabel = label;
      window.clearTimeout(this.labelTimer);
      if (label === this.status.textContent) { delete this.status.dataset.fading; return; }
      if (this.motion.matches) { this.status.textContent = label; return; }
      this.status.dataset.fading = 'true';
      this.labelTimer = window.setTimeout(() => {
        if (!this.status) return;
        this.status.textContent = label;
        delete this.status.dataset.fading;
      }, 220);
    }

    private render() {
      const time = this.elapsed % this.cycle, round = Math.floor(this.elapsed / this.cycle) % 3;
      const branch = ['feedback', 'retry', 'finish'][round];
      const selected = (id: string) => !['feedback', 'retry', 'finish'].includes(id) || id === branch;
      const activeNodes = new Set<string>();
      this.paths.forEach((path, id) => {
        const flight = this.flights.get(id);
        const active = Boolean(flight && selected(id) && time >= flight.start - 180 && time <= flight.start + flight.duration + 520);
        path.toggleAttribute('data-active', active);
        if (active) { activeNodes.add(path.dataset.from!); activeNodes.add(path.dataset.to!); }
      });
      this.nodes.forEach((node, id) => node.toggleAttribute('data-active', activeNodes.has(id)));
      let label = this.markers[0]?.label || '编排上下文';
      this.markers.forEach(marker => { if (time >= marker.time) label = marker.label; });
      if (time >= this.markers[this.markers.length - 1].time && round === 1) label = '评估未通过 · 返回规划';
      if (time >= this.markers[this.markers.length - 1].time && round === 2) label = '目标达成 · 输出结果';
      this.setLabel(label);
      this.packets.forEach(({ element, id, delay }) => {
        const flight = this.flights.get(id), path = this.paths.get(id);
        if (!flight || !path || !selected(id) || this.motion.matches) { element.setAttribute('opacity', '0'); return; }
        const progress = (time - flight.start - delay) / flight.duration;
        if (progress <= 0 || progress >= 1) { element.setAttribute('opacity', '0'); return; }
        const length = this.lengths.get(id) || 0;
        const point = path.getPointAtLength(length * progress);
        const next = path.getPointAtLength(Math.min(length, length * progress + .5));
        const angle = Math.atan2(next.y - point.y, next.x - point.x) * 180 / Math.PI;
        const envelope = Math.min(1, progress / .14, (1 - progress) / .14);
        const opacity = envelope * envelope * (3 - 2 * envelope);
        element.setAttribute('opacity', String(opacity));
        element.setAttribute('transform', `translate(${point.x} ${point.y}) rotate(${angle})`);
      });
    }
  }
  if (!customElements.get('agent-execution')) customElements.define('agent-execution', AgentExecution);
</script>
