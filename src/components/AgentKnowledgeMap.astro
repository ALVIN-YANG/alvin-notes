---
import knowledgeData from '../data/agent-knowledge.json';

const serializedData = JSON.stringify(knowledgeData).replace(/</g, '\\u003c');
const levelLabels = { core: '核心', scenario: '场景', advanced: '进阶' };
const domainPalette = {
  foundations: { accent: '#446fdb', tint: '#f2f5fc', wash: '#e6edfb' },
  'model-context': { accent: '#2d8b69', tint: '#f0f7f3', wash: '#e0f0e7' },
  'knowledge-state': { accent: '#ad7b23', tint: '#faf6ed', wash: '#f3e8cf' },
  'tools-environment': { accent: '#356fda', tint: '#eef4ff', wash: '#dfe9fb' },
  'runtime-orchestration': { accent: '#7a5db0', tint: '#f5f2fa', wash: '#ebe4f5' },
  'evaluation-evolution': { accent: '#27848d', tint: '#eff7f7', wash: '#dceced' },
  'safety-governance': { accent: '#c35f58', tint: '#fbf2f1', wash: '#f3e2df' },
  'production-platform': { accent: '#4b88a9', tint: '#f1f6f8', wash: '#deebf0' },
  'interaction-collaboration': { accent: '#a6782f', tint: '#f9f5ed', wash: '#efe5d2' },
};
const gridPositions = [
  { column: 1, row: 1 },
  { column: 2, row: 1 },
  { column: 3, row: 1 },
  { column: 3, row: 2 },
  { column: 2, row: 2 },
  { column: 1, row: 2 },
  { column: 1, row: 3 },
  { column: 2, row: 3 },
  { column: 3, row: 3 },
];
---

<agent-knowledge-map class="agent-map" data-level-filter="all" data-density="points">
  <header class="map-toolbar">
    <a class="map-brand" href="/" aria-label="返回博客首页">
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m14.5 6.5-5 5 5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>
        <strong>Agent 学习地图</strong>
        <small>{knowledgeData.meta.pointCount} 个知识点</small>
      </span>
    </a>

    <div class="map-search" data-search-shell>
      <label class="sr-only" for="agent-map-search">搜索知识点</label>
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m20 20-4.2-4.2m1.7-5.3a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
      <input id="agent-map-search" data-search-input type="search" placeholder="搜索知识点" autocomplete="off" aria-controls="agent-map-results" aria-expanded="false" />
      <div class="map-search-results" id="agent-map-results" data-search-results hidden></div>
    </div>

    <div class="map-toolbar-actions">
      <div class="level-filter" aria-label="筛选知识层级">
        <button type="button" data-level="all" aria-pressed="true">全部</button>
        <button type="button" data-level="core" aria-pressed="false">核心</button>
        <button type="button" data-level="scenario" aria-pressed="false">场景</button>
        <button type="button" data-level="advanced" aria-pressed="false">进阶</button>
      </div>
      <button class="fit-map" type="button" data-fit-map>
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M8 3H3v5m13-5h5v5M8 21H3v-5m13 5h5v-5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>适应画布</span>
      </button>
    </div>
  </header>

  <main class="map-workspace">
    <div class="map-canvas" data-map-canvas aria-label="可以拖动和缩放的 Agent 学习地图">
      <div class="map-world" data-map-world>
        <div class="domain-grid" data-domain-grid>
          <svg class="map-paths" data-map-paths aria-hidden="true"></svg>
          {
            knowledgeData.domains.map((domain, index) => {
              const colors = domainPalette[domain.id as keyof typeof domainPalette];
              const position = gridPositions[index];
              const pointCount = domain.groups.reduce((total, group) => total + group.points.length, 0);
              const style = [
                `--domain-accent: ${colors.accent}`,
                `--domain-tint: ${colors.tint}`,
                `--domain-wash: ${colors.wash}`,
                `--grid-column: ${position.column}`,
                `--grid-row: ${position.row}`,
              ].join(';');

              return (
                <article
                  class="knowledge-domain-card"
                  data-domain-id={domain.id}
                  data-domain-index={index}
                  style={style}
                >
                  <button type="button" class="domain-card-header" data-focus-domain={domain.id}>
                    <span class="domain-stage">{domain.code}</span>
                    <span class="domain-heading-copy">
                      <strong>{domain.title}</strong>
                      <small>{domain.summary}</small>
                    </span>
                    <span class="domain-count">{pointCount}</span>
                  </button>

                  <div class="domain-groups">
                    {
                      domain.groups.map((group) => (
                        <section class="map-group" data-level={group.level} data-group-id={group.id}>
                          <button type="button" class="map-group-heading" data-focus-group={group.id}>
                            <strong>{group.title}</strong>
                            <span>{levelLabels[group.level as keyof typeof levelLabels] ?? group.level}</span>
                          </button>
                          <div class="map-points">
                            {
                              group.points.map((point) => (
                                <button
                                  type="button"
                                  class="map-point"
                                  data-open-point={point.id}
                                  data-level={group.level}
                                >
                                  {point.title}
                                </button>
                              ))
                            }
                          </div>
                        </section>
                      ))
                    }
                  </div>
                </article>
              );
            })
          }
        </div>
      </div>
    </div>

    <div class="map-guide" data-map-guide>
      <span class="guide-mark" aria-hidden="true"></span>
      <span>拖动画布浏览，滚轮缩放，点击知识点查看详情</span>
    </div>

    <div class="map-zoom" aria-label="画布缩放">
      <button type="button" data-zoom="out" aria-label="缩小">−</button>
      <span data-zoom-value>100%</span>
      <button type="button" data-zoom="in" aria-label="放大">＋</button>
    </div>

    <aside class="point-panel" data-point-panel hidden aria-label="知识点详情">
      <div class="panel-topline">
        <span data-panel-stage></span>
        <button type="button" data-close-panel aria-label="关闭知识点详情">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m7 7 10 10M17 7 7 17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </button>
      </div>

      <div class="panel-heading">
        <p data-panel-path></p>
        <h2 data-panel-title></h2>
        <div class="panel-tags" data-panel-tags></div>
      </div>

      <div class="panel-body">
        <article class="panel-article" data-panel-content></article>

        <section class="panel-sources">
          <h3>书中位置</h3>
          <div data-panel-sources></div>
        </section>

        <section class="panel-reading" data-panel-reading-section>
          <h3>相关文章</h3>
          <div data-panel-reading></div>
        </section>
      </div>
    </aside>
  </main>

  <div class="sr-only" aria-live="polite" data-announcer></div>
  <script type="application/json" data-map-data set:html={serializedData}></script>
</agent-knowledge-map>

<script>
  const levelNames = { core: '核心', scenario: '场景', advanced: '进阶' };
  const SVG_NAMESPACE = 'http://www.w3.org/2000/svg';

  const escapeHTML = (value) => String(value ?? '')
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#039;');

  const clamp = (value, minimum, maximum) => Math.min(maximum, Math.max(minimum, value));

  class AgentKnowledgeMap extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready === 'true') return;
      this.dataset.ready = 'true';

      const dataNode = this.querySelector('[data-map-data]');
      if (!dataNode?.textContent) return;

      const data = JSON.parse(dataNode.textContent);
      const pointById = new Map();
      const groupById = new Map();
      const pointRecords = [];

      data.domains.forEach((domain, domainIndex) => {
        domain.groups.forEach((group, groupIndex) => {
          groupById.set(group.id, { group, domain });
          group.points.forEach((point, pointIndex) => {
            const record = { point, group, domain, domainIndex, groupIndex, pointIndex };
            pointRecords.push(record);
            pointById.set(point.id, record);
          });
        });
      });

      const canvas = this.querySelector('[data-map-canvas]');
      const world = this.querySelector('[data-map-world]');
      const grid = this.querySelector('[data-domain-grid]');
      const paths = this.querySelector('[data-map-paths]');
      const searchInput = this.querySelector('[data-search-input]');
      const searchResults = this.querySelector('[data-search-results]');
      const panel = this.querySelector('[data-point-panel]');
      const announcer = this.querySelector('[data-announcer]');
      const domainCards = [...this.querySelectorAll('[data-domain-id]')]
        .sort((left, right) => Number(left.dataset.domainIndex) - Number(right.dataset.domainIndex));
      const view = { x: 0, y: 0, scale: 1 };
      let dragState;

      const setText = (selector, value) => {
        const node = this.querySelector(selector);
        if (node) node.textContent = value;
      };

      const setDensity = (scale) => {
        this.dataset.density = scale < 0.58 ? 'overview' : scale < 0.78 ? 'groups' : 'points';
        setText('[data-zoom-value]', `${Math.round(scale * 100)}%`);
      };

      const renderView = () => {
        world.style.transform = `translate3d(${view.x}px, ${view.y}px, 0) scale(${view.scale})`;
        setDensity(view.scale);
      };

      const setView = ({ x = view.x, y = view.y, scale = view.scale }) => {
        view.x = x;
        view.y = y;
        view.scale = clamp(scale, 0.26, 1.3);
        renderView();
      };

      const zoomAt = (nextScale, clientX, clientY) => {
        const bounds = canvas.getBoundingClientRect();
        const localX = clientX - bounds.left;
        const localY = clientY - bounds.top;
        const contentX = (localX - view.x) / view.scale;
        const contentY = (localY - view.y) / view.scale;
        const scale = clamp(nextScale, 0.26, 1.3);
        setView({
          x: localX - contentX * scale,
          y: localY - contentY * scale,
          scale,
        });
      };

      const drawConnectors = () => {
        const width = grid.scrollWidth;
        const height = grid.scrollHeight;
        paths.setAttribute('viewBox', `0 0 ${width} ${height}`);
        paths.setAttribute('width', String(width));
        paths.setAttribute('height', String(height));
        paths.replaceChildren();

        domainCards.slice(0, -1).forEach((from, index) => {
          const to = domainCards[index + 1];
          const sameRow = Math.abs(from.offsetTop - to.offsetTop) < 4;
          let startX;
          let startY;
          let endX;
          let endY;
          let pathData;

          if (sameRow) {
            const movingRight = to.offsetLeft > from.offsetLeft;
            startX = movingRight ? from.offsetLeft + from.offsetWidth : from.offsetLeft;
            endX = movingRight ? to.offsetLeft : to.offsetLeft + to.offsetWidth;
            startY = from.offsetTop + Math.min(92, from.offsetHeight * 0.24);
            endY = to.offsetTop + Math.min(92, to.offsetHeight * 0.24);
            const direction = movingRight ? 1 : -1;
            const bend = Math.max(34, Math.abs(endX - startX) * 0.44);
            pathData = `M ${startX} ${startY} C ${startX + bend * direction} ${startY}, ${endX - bend * direction} ${endY}, ${endX} ${endY}`;
          } else {
            startX = from.offsetLeft + from.offsetWidth / 2;
            endX = to.offsetLeft + to.offsetWidth / 2;
            startY = from.offsetTop + from.offsetHeight;
            endY = to.offsetTop;
            const bend = Math.max(36, Math.abs(endY - startY) * 0.5);
            pathData = `M ${startX} ${startY} C ${startX} ${startY + bend}, ${endX} ${endY - bend}, ${endX} ${endY}`;
          }

          const path = document.createElementNS(SVG_NAMESPACE, 'path');
          path.setAttribute('class', 'map-connector');
          path.setAttribute('d', pathData);
          paths.append(path);
        });
      };

      const domainCard = (domainId) => this.querySelector(`[data-domain-id="${CSS.escape(domainId)}"]`);

      const focusDomain = (domainId, scale = 0.96) => {
        const card = domainCard(domainId);
        if (!card) return;
        const panelSpace = !panel.hidden && window.innerWidth >= 900 ? panel.offsetWidth + 36 : 0;
        const availableWidth = Math.max(320, canvas.clientWidth - panelSpace);
        const contentX = grid.offsetLeft + card.offsetLeft + card.offsetWidth / 2;
        const contentY = grid.offsetTop + card.offsetTop;
        setView({
          x: availableWidth / 2 - contentX * scale,
          y: 28 - contentY * scale,
          scale,
        });
      };

      const fitMap = () => {
        const horizontal = (canvas.clientWidth - 64) / world.scrollWidth;
        const vertical = (canvas.clientHeight - 64) / world.scrollHeight;
        const scale = clamp(Math.min(horizontal, vertical), 0.26, 0.68);
        setView({
          x: (canvas.clientWidth - world.scrollWidth * scale) / 2,
          y: (canvas.clientHeight - world.scrollHeight * scale) / 2,
          scale,
        });
      };

      const resetView = () => {
        const mobile = window.innerWidth < 640;
        setView({ x: mobile ? 0 : 18, y: mobile ? 0 : 14, scale: 1 });
      };

      const clearHighlights = () => {
        this.querySelectorAll('.map-point.is-active, .map-group.is-focused').forEach((node) => {
          node.classList.remove('is-active', 'is-focused');
        });
      };

      const focusGroup = (groupId) => {
        const record = groupById.get(groupId);
        if (!record) return;
        closePanel();
        focusDomain(record.domain.id, 1);
        window.requestAnimationFrame(() => {
          this.querySelector(`[data-group-id="${CSS.escape(groupId)}"]`)?.classList.add('is-focused');
        });
      };

      const setPanelTags = (record) => {
        const container = this.querySelector('[data-panel-tags]');
        container.replaceChildren();
        [levelNames[record.group.level] ?? record.group.level, record.group.title].forEach((label, index) => {
          const span = document.createElement('span');
          if (index === 0) span.className = 'is-level';
          span.textContent = label;
          container.append(span);
        });
      };

      const setPanelReading = (record) => {
        const section = this.querySelector('[data-panel-reading-section]');
        const container = this.querySelector('[data-panel-reading]');
        const articles = record.domain.articles ?? [];
        section.hidden = articles.length === 0;
        container.replaceChildren();
        articles.forEach((article) => {
          const link = document.createElement('a');
          link.href = article.href;
          link.innerHTML = `<span>${escapeHTML(article.title)}</span><i aria-hidden="true">↗</i>`;
          container.append(link);
        });
      };

      const setPanelContent = (record) => {
        const container = this.querySelector('[data-panel-content]');
        container.replaceChildren();
        (record.point.content ?? []).forEach((block) => {
          if (block.type === 'heading') {
            const heading = document.createElement('h3');
            heading.textContent = block.text;
            container.append(heading);
            return;
          }
          if (block.type === 'list') {
            const list = document.createElement('ul');
            block.items.forEach((item) => {
              const entry = document.createElement('li');
              entry.textContent = item;
              list.append(entry);
            });
            container.append(list);
            return;
          }
          const paragraph = document.createElement('p');
          paragraph.textContent = block.text;
          container.append(paragraph);
        });
      };

      const setPanelSources = (record) => {
        const container = this.querySelector('[data-panel-sources]');
        container.replaceChildren();
        (record.group.references ?? []).forEach((reference) => {
          const item = document.createElement('div');
          const title = document.createElement('strong');
          const location = document.createElement('span');
          title.textContent = reference.title;
          location.textContent = reference.location;
          item.append(title, location);
          container.append(item);
        });
      };

      const openPoint = (record, { updateUrl = true, focus = true } = {}) => {
        panel.hidden = false;
        setText('[data-panel-stage]', `阶段 ${record.domain.code}`);
        setText('[data-panel-path]', `${record.domain.short} · ${record.group.title}`);
        setText('[data-panel-title]', record.point.title);
        setPanelTags(record);
        setPanelContent(record);
        setPanelSources(record);
        setPanelReading(record);

        clearHighlights();
        if (focus) focusDomain(record.domain.id, window.innerWidth < 900 ? 1 : 0.96);
        window.requestAnimationFrame(() => {
          this.querySelector(`[data-open-point="${CSS.escape(record.point.id)}"]`)?.classList.add('is-active');
        });

        if (updateUrl) history.pushState(null, '', `${location.pathname}${location.search}#${record.point.id}`);
        document.title = `${record.point.title} · Agent 学习地图`;
        announcer.textContent = `已打开 ${record.point.title}`;
      };

      const closePanel = ({ updateUrl = true } = {}) => {
        panel.hidden = true;
        clearHighlights();
        document.title = 'Agent 学习地图';
        if (updateUrl && location.hash) history.replaceState(null, '', `${location.pathname}${location.search}`);
      };

      const renderSearch = () => {
        const query = searchInput.value.trim().toLocaleLowerCase('zh-CN');
        if (!query) {
          searchResults.hidden = true;
          searchInput.setAttribute('aria-expanded', 'false');
          return;
        }
        const matches = pointRecords.filter(({ point, group, domain }) => {
          const explanation = (point.content ?? []).flatMap((block) => block.items ?? block.text ?? '').join(' ');
          const haystack = `${point.title} ${explanation} ${group.title} ${domain.title}`.toLocaleLowerCase('zh-CN');
          return haystack.includes(query);
        }).slice(0, 10);
        searchResults.innerHTML = matches.length ? matches.map(({ point, group, domain }) => `
          <button type="button" data-search-point="${escapeHTML(point.id)}">
            <strong>${escapeHTML(point.title)}</strong>
            <small>${escapeHTML(domain.short)} · ${escapeHTML(group.title)}</small>
          </button>
        `).join('') : '<p>没有找到匹配的知识点</p>';
        searchResults.hidden = false;
        searchInput.setAttribute('aria-expanded', 'true');
      };

      const applyLevel = (level) => {
        this.dataset.levelFilter = level;
        this.querySelectorAll('.level-filter [data-level]').forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.level === level));
        });
      };

      const handleLocation = () => {
        const id = decodeURIComponent(location.hash.slice(1));
        const record = pointById.get(id);
        if (record) openPoint(record, { updateUrl: false });
        else closePanel({ updateUrl: false });
      };

      this.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target : null;
        if (!target) return;

        const pointButton = target.closest('[data-open-point]');
        if (pointButton) {
          const record = pointById.get(pointButton.dataset.openPoint);
          if (record) openPoint(record);
          return;
        }

        const searchButton = target.closest('[data-search-point]');
        if (searchButton) {
          const record = pointById.get(searchButton.dataset.searchPoint);
          if (record) {
            applyLevel('all');
            openPoint(record);
            searchResults.hidden = true;
            searchInput.setAttribute('aria-expanded', 'false');
          }
          return;
        }

        const groupButton = target.closest('[data-focus-group]');
        if (groupButton) {
          focusGroup(groupButton.dataset.focusGroup);
          return;
        }

        const domainButton = target.closest('[data-focus-domain]');
        if (domainButton) {
          closePanel();
          focusDomain(domainButton.dataset.focusDomain, 0.96);
          return;
        }

        const levelButton = target.closest('.level-filter [data-level]');
        if (levelButton) {
          applyLevel(levelButton.dataset.level);
          return;
        }

        if (target.closest('[data-close-panel]')) {
          closePanel();
          return;
        }

        if (target.closest('[data-fit-map]')) {
          closePanel();
          fitMap();
          return;
        }

        const zoomButton = target.closest('[data-zoom]');
        if (zoomButton) {
          const bounds = canvas.getBoundingClientRect();
          const delta = zoomButton.dataset.zoom === 'in' ? 0.12 : -0.12;
          zoomAt(view.scale + delta, bounds.left + bounds.width / 2, bounds.top + bounds.height / 2);
          return;
        }

        if (!target.closest('[data-search-shell]')) {
          searchResults.hidden = true;
          searchInput.setAttribute('aria-expanded', 'false');
        }
      });

      canvas.addEventListener('wheel', (event) => {
        event.preventDefault();
        const factor = Math.exp(-event.deltaY * 0.0015);
        zoomAt(view.scale * factor, event.clientX, event.clientY);
      }, { passive: false });

      canvas.addEventListener('pointerdown', (event) => {
        if (event.button !== 0) return;
        const target = event.target instanceof Element ? event.target : null;
        if (target?.closest('button, a, input')) return;
        dragState = { pointerId: event.pointerId, x: event.clientX, y: event.clientY, viewX: view.x, viewY: view.y };
        canvas.setPointerCapture(event.pointerId);
        canvas.classList.add('is-panning');
      });

      canvas.addEventListener('pointermove', (event) => {
        if (!dragState || dragState.pointerId !== event.pointerId) return;
        setView({
          x: dragState.viewX + event.clientX - dragState.x,
          y: dragState.viewY + event.clientY - dragState.y,
        });
      });

      const endDrag = (event) => {
        if (!dragState || dragState.pointerId !== event.pointerId) return;
        dragState = undefined;
        canvas.classList.remove('is-panning');
        if (canvas.hasPointerCapture(event.pointerId)) canvas.releasePointerCapture(event.pointerId);
      };
      canvas.addEventListener('pointerup', endDrag);
      canvas.addEventListener('pointercancel', endDrag);

      searchInput.addEventListener('input', renderSearch);
      searchInput.addEventListener('focus', renderSearch);
      window.addEventListener('popstate', handleLocation);
      window.addEventListener('resize', drawConnectors);
      new ResizeObserver(drawConnectors).observe(grid);

      window.requestAnimationFrame(() => {
        drawConnectors();
        if (location.hash && pointById.has(decodeURIComponent(location.hash.slice(1)))) handleLocation();
        else resetView();
        this.dataset.mapReady = 'true';
        performance.mark('agent-map-ready');
      });
    }
  }

  if (!customElements.get('agent-knowledge-map')) customElements.define('agent-knowledge-map', AgentKnowledgeMap);
</script>
