---
const { indexUrl = "/system-design-search.json", label = "搜索系统设计文档" } = Astro.props;
---
<primer-search data-index-url={indexUrl}>
  <button type="button" disabled class="primer-search-open" aria-label={label} aria-keyshortcuts="Control+K Meta+K">搜索文档 <kbd>⌘ K</kbd></button>
  <dialog class="primer-search-dialog" aria-label={label}>
    <form method="dialog" class="primer-search-bar">
      <label for="primer-search-input">搜索文档</label>
      <input id="primer-search-input" type="search" placeholder="搜索章节或正文" autocomplete="off" />
      <button type="submit">关闭</button>
    </form>
    <p class="primer-search-status" role="status">输入关键词，查找中文原文。</p>
    <ul class="primer-search-results"></ul>
  </dialog>
</primer-search>
<script>
  type Record = {chapter: string; title: string; url: string; text: string};
  class PrimerSearch extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const open = this.querySelector<HTMLButtonElement>('.primer-search-open')!;
      const dialog = this.querySelector<HTMLDialogElement>('dialog')!;
      const input = this.querySelector<HTMLInputElement>('input')!;
      const results = this.querySelector<HTMLUListElement>('ul')!;
      const status = this.querySelector<HTMLParagraphElement>('[role="status"]')!;
      let index: Promise<Record[]> | undefined;
      let revision = 0;
      const load = () => index ??= fetch(this.dataset.indexUrl || '/system-design-search.json').then(response => {
        if (!response.ok) throw new Error('Search index unavailable');
        return response.json();
      }).catch(error => { index = undefined; throw error; });
      const show = () => { dialog.showModal(); input.focus(); };
      open.addEventListener('click', show);
      const headerTrigger = document.querySelector<HTMLButtonElement>('[data-primer-search-trigger]');
      headerTrigger?.addEventListener('click', show);
      open.disabled = false;
      if (headerTrigger) headerTrigger.disabled = false;
      dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
      dialog.addEventListener('close', () => open.focus());
      dialog.addEventListener('keydown', event => {
        if (event.key === 'Escape') { event.preventDefault(); event.stopPropagation(); dialog.close(); }
      });
      dialog.addEventListener('keyup', event => { if (event.key === 'Escape') event.stopPropagation(); });
      this.querySelector('form')!.addEventListener('submit', event => {
        if ((event as SubmitEvent).submitter === null) event.preventDefault();
      });
      const shortcut = (event: KeyboardEvent) => {
        if ((event.ctrlKey || event.metaKey) && event.key === 'k') {
          event.preventDefault();
          dialog.open ? dialog.close() : show();
        }
      };
      document.addEventListener('keydown', shortcut);
      document.addEventListener('astro:before-swap', () => document.removeEventListener('keydown', shortcut), { once: true });
      input.addEventListener('keydown', event => {
        if (event.key === 'Enter') { event.preventDefault(); results.querySelector('a')?.click(); }
      });
      input.addEventListener('input', async () => {
        const current = ++revision;
        const query = input.value.trim().toLocaleLowerCase();
        results.replaceChildren();
        if (!query) { status.textContent = '输入关键词，查找中文原文。'; return; }
        status.textContent = '正在查找…';
        try {
          const records = await load();
          if (current !== revision) return;
          const terms = query.split(/\s+/);
          const matches = records.filter(record => terms.every(term => `${record.title} ${record.text}`.toLocaleLowerCase().includes(term)))
            .sort((a, b) => Number(b.title.toLocaleLowerCase().includes(query)) - Number(a.title.toLocaleLowerCase().includes(query)) || Number(b.url.toLocaleLowerCase().includes(query)) - Number(a.url.toLocaleLowerCase().includes(query)));
          status.textContent = matches.length ? `找到 ${matches.length} 个相关小节${matches.length > 20 ? '，显示前 20 个' : ''}` : '没有找到相关小节，试试其他关键词。';
          for (const record of matches.slice(0, 20)) {
            const item = document.createElement('li');
            const link = document.createElement('a');
            link.href = record.url;
            const title = document.createElement('strong');
            title.textContent = record.chapter === record.title ? record.title : `${record.chapter} · ${record.title}`;
            const excerpt = document.createElement('span');
            const position = record.text.toLocaleLowerCase().indexOf(terms[0]);
            const start = Math.max(0, position - 28);
            excerpt.textContent = `${start ? '…' : ''}${record.text.slice(start, start + 130)}${record.text.length > start + 130 ? '…' : ''}`;
            link.append(title, excerpt);
            link.addEventListener('click', () => {
              dialog.close();
              document.querySelector<HTMLButtonElement>('starlight-menu-button[aria-expanded="true"] button')?.click();
            });
            item.append(link);
            results.append(item);
          }
        } catch { if (current === revision) status.textContent = '暂时无法加载搜索，修改关键词可重试，也可使用章节目录。'; }
      });
    }
  }
  if (!customElements.get('primer-search')) customElements.define('primer-search', PrimerSearch);
</script>
