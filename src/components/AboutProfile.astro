---
import { portfolio } from '../data/portfolio';

const path = [
  { year: '2016', label: 'CLIENT', value: 'iOS 客户端' },
  { year: '2019', label: 'SERVICE', value: 'Java 后端' },
  { year: '2021', label: 'PLATFORM', value: '云端 DevOps' },
  { year: '2023', label: 'AGENT', value: 'AI Agent 与智能硬件' },
];

const works = portfolio.filter((project) => project.featured);
---

<div class="about-profile not-content">
  <header class="profile-head">
    <div class="profile-meta">
      <span>PROFILE / SINCE 2016</span>
      <span class="profile-place">HANGZHOU / CHINA</span>
    </div>

    <div class="hero-grid">
      <div class="identity">
        <div class="identity-mark">
          <span class="identity-avatar" aria-hidden="true"></span>
          <span>杨卢青</span>
        </div>
        <h1>Alvin Yang</h1>
        <p class="positioning">AI Agent 开发工程师，做智能硬件的软件系统，也独立开发应用与工具。</p>
        <p class="intro">
          2016 年开始做软件，从 iOS 到后端，再到云端 DevOps 和 AI Agent。现在主要处理 Agent、智能硬件与长期运行系统之间的工程问题。
        </p>
        <nav class="profile-links" aria-label="个人链接">
          <a href="/projects/">作品集 <span aria-hidden="true">↗</span></a>
          <a href="https://github.com/ALVIN-YANG" target="_blank" rel="noreferrer">
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>

      <aside class="status-board" aria-label="当前关注">
        <div class="status-row">
          <span class="status-label">NOW</span>
          <span>AI Agent 与智能硬件</span>
        </div>
        <div class="status-row">
          <span class="status-label">BUILDING</span>
          <span>上下文、工具与评测</span>
        </div>
        <div class="status-row">
          <span class="status-label">WRITING</span>
          <span>架构与工程实践</span>
        </div>
      </aside>
    </div>

    <ol class="career-path" aria-label="工作方向变化">
      {path.map((item) => (
        <li>
          <span class="path-year">{item.year}</span>
          <span class="path-label">{item.label}</span>
          <strong>{item.value}</strong>
        </li>
      ))}
    </ol>
  </header>

  <section class="selected-work" id="selected-work" aria-labelledby="selected-work-title">
    <div class="section-head">
      <p>SELECTED WORK</p>
      <h2 id="selected-work-title">独立作品</h2>
    </div>

    <div class="work-list">
      {works.map((work) => (
        <a class="work-row" href={`/projects/#${work.id}`}>
          <span class="work-label">{work.category}</span>
          <span class="work-copy">
            <span class="work-title">{work.name}</span>
            <span class="work-description">{work.summary}</span>
          </span>
          <span class="work-status">{work.status}</span>
          <span class="work-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
    <nav class="profile-links" aria-label="更多作品">
      <a href="/projects/">全部作品 <span aria-hidden="true">→</span></a>
    </nav>
  </section>

  <footer class="profile-contact">
    <div>
      <span class="contact-label">CONTACT</span>
      <p>如果你也在做 Agent、基础设施或长期运行的软件，可以在 GitHub 找到我。</p>
    </div>
    <a href="https://github.com/ALVIN-YANG" target="_blank" rel="noreferrer">
      github.com/ALVIN-YANG <span aria-hidden="true">↗</span>
    </a>
  </footer>
</div>

<style>
  .about-profile {
    --profile-ink: #232823;
    --profile-muted: #727871;
    --profile-line: #d8d8ce;
    --profile-accent: #b96828;
    width: min(100%, 68rem);
    margin: 0 auto;
    padding: clamp(1.5rem, 3vw, 3rem) 0 clamp(3rem, 6vw, 5rem);
    color: var(--profile-ink);
  }

  .profile-head {
    display: flex;
    min-height: clamp(29rem, 58vh, 35rem);
    flex-direction: column;
    justify-content: space-between;
  }

  .profile-meta,
  .path-label,
  .status-label,
  .section-head p,
  .work-label,
  .work-status,
  .contact-label {
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    line-height: 1.4;
  }

  .profile-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--profile-muted);
  }

  .profile-place::before {
    display: inline-block;
    width: 0.42rem;
    height: 0.42rem;
    margin-right: 0.55rem;
    border-radius: 50%;
    background: var(--profile-accent);
    content: '';
    vertical-align: 0.03rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(15rem, 0.72fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: end;
    padding: clamp(3rem, 6vw, 5rem) 0 clamp(2.75rem, 5vw, 4.25rem);
  }

  .identity-mark {
    display: flex;
    gap: 0.65rem;
    align-items: center;
    margin-bottom: 1rem;
    color: var(--profile-muted);
    font-size: 0.82rem;
    letter-spacing: 0.1em;
  }

  .identity-avatar {
    display: block;
    flex: 0 0 auto;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 0.55rem;
    background: #f8f5eb url('/images/brand/alvin-programmer.webp') center 28% / 220% auto no-repeat;
    opacity: 0.92;
  }

  h1,
  h2,
  p {
    margin: 0;
  }

  h1 {
    max-width: 9ch;
    font-family: var(--sl-font-heading);
    font-size: clamp(3.2rem, 6.2vw, 5rem);
    font-weight: 650;
    letter-spacing: -0.065em;
    line-height: 0.88;
  }

  .positioning {
    max-width: 27ch;
    margin-top: 1.5rem;
    font-family: var(--sl-font-heading);
    font-size: clamp(1.15rem, 1.65vw, 1.4rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.55;
  }

  .intro {
    max-width: 36rem;
    margin-top: 0.85rem;
    color: var(--profile-muted);
    font-size: 0.92rem;
    line-height: 1.75;
  }

  .profile-links {
    display: flex;
    gap: 1.65rem;
    margin-top: 1.5rem;
  }

  .profile-links a,
  .profile-contact a {
    color: var(--profile-ink);
    font-size: 0.86rem;
    font-weight: 650;
    text-decoration: none;
    text-underline-offset: 0.35rem;
  }

  .profile-links a:hover,
  .profile-contact a:hover {
    color: var(--profile-accent);
    text-decoration: underline;
  }

  .profile-links span,
  .profile-contact a span {
    margin-left: 0.3rem;
    color: var(--profile-accent);
  }

  .status-board {
    border-top: 1px solid var(--profile-ink);
    border-bottom: 1px solid var(--profile-line);
  }

  .status-row {
    display: grid;
    grid-template-columns: 5.4rem 1fr;
    gap: 1rem;
    padding: 0.82rem 0;
    border-bottom: 1px solid var(--profile-line);
    color: var(--profile-ink);
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .status-row:last-child {
    border-bottom: 0;
  }

  .status-label {
    color: var(--profile-muted);
  }

  .career-path {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--profile-ink);
    list-style: none;
  }

  .career-path li {
    display: grid;
    min-width: 0;
    gap: 0.4rem;
    padding: 0.9rem 1.2rem 0 0;
  }

  .path-year {
    color: var(--profile-ink);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
  }

  .path-label {
    color: var(--profile-muted);
  }

  .career-path strong {
    font-size: 0.84rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .selected-work {
    padding-top: clamp(4rem, 8vw, 6.5rem);
    scroll-margin-top: calc(var(--sl-nav-height) + 2rem);
  }

  .section-head {
    display: grid;
    grid-template-columns: minmax(10rem, 0.58fr) 1.42fr;
    gap: 2rem;
    align-items: baseline;
    margin-bottom: 1.25rem;
  }

  .section-head p {
    color: var(--profile-muted);
  }

  .section-head h2 {
    font-family: var(--sl-font-heading);
    font-size: clamp(1.75rem, 3vw, 2.6rem);
    font-weight: 650;
    letter-spacing: -0.04em;
    line-height: 1.15;
  }

  .work-list {
    border-top: 1px solid var(--profile-ink);
  }

  .work-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(10rem, 0.58fr) minmax(0, 1.42fr) 6.5rem 1.2rem;
    gap: 2rem;
    align-items: start;
    min-height: 7.6rem;
    padding: 1.25rem 0;
    overflow: hidden;
    border-bottom: 1px solid var(--profile-line);
    color: var(--profile-ink);
    text-decoration: none;
  }

  .work-label,
  .work-status {
    position: relative;
    z-index: 1;
    padding-top: 0.4rem;
    color: var(--profile-muted);
  }

  .work-copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.5rem;
  }

  .work-title {
    font-family: var(--sl-font-heading);
    font-size: clamp(1.3rem, 2vw, 1.65rem);
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.3;
    transition: color 160ms ease, transform 160ms ease;
  }

  .work-description {
    max-width: 38rem;
    color: var(--profile-muted);
    font-size: 0.86rem;
    line-height: 1.7;
  }

  .work-arrow {
    position: relative;
    z-index: 1;
    color: var(--profile-accent);
    font-size: 1rem;
    transition: transform 160ms ease;
  }

  .work-row:hover .work-title,
  .work-row:focus-visible .work-title {
    color: var(--profile-accent);
    transform: translateX(0.25rem);
  }

  .work-row:hover .work-arrow,
  .work-row:focus-visible .work-arrow {
    transform: translate(0.18rem, -0.18rem);
  }

  .profile-contact {
    display: grid;
    grid-template-columns: 1.35fr auto;
    gap: 3rem;
    align-items: end;
    margin-top: clamp(4rem, 8vw, 6.5rem);
    padding-top: 1.2rem;
    border-top: 1px solid var(--profile-ink);
  }

  .contact-label {
    display: block;
    margin-bottom: 0.7rem;
    color: var(--profile-muted);
  }

  .profile-contact p {
    max-width: 31rem;
    font-family: var(--sl-font-heading);
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    font-weight: 600;
    line-height: 1.55;
  }

  .profile-links a:focus-visible,
  .work-row:focus-visible,
  .profile-contact a:focus-visible {
    border-radius: 0.2rem;
    outline: 2px solid var(--profile-accent);
    outline-offset: 0.35rem;
  }

  :global([data-theme='dark']) .about-profile {
    --profile-ink: #ecece4;
    --profile-muted: #a6aaa3;
    --profile-line: #393d38;
    --profile-accent: #db8b48;
  }

  @media (max-width: 52rem) {
    .profile-head {
      min-height: auto;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .career-path {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 1.5rem;
    }

    .section-head {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .work-row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.7rem 1.5rem;
      min-height: 0;
      padding: 1.2rem 0;
    }

    .work-label,
    .work-copy {
      grid-column: 1;
    }

    .work-status,
    .work-arrow {
      grid-column: 2;
      grid-row: 1;
    }

    .work-arrow {
      grid-row: 2;
      justify-self: end;
    }

    .system-trace {
      right: 3rem;
      width: 13rem;
    }

    .profile-contact {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 34rem) {
    .about-profile {
      padding-top: 1.25rem;
    }

    .profile-place {
      display: none;
    }

    .hero-grid {
      padding-top: 2.75rem;
    }

    h1 {
      font-size: clamp(3.1rem, 16vw, 4.2rem);
    }

    .career-path {
      gap: 0.75rem;
    }

    .career-path li {
      padding-right: 0.5rem;
    }

    .work-description {
      font-size: 0.86rem;
    }

    .work-status {
      font-size: 0.58rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-title,
    .work-arrow {
      transition: none;
    }
  }
</style>
