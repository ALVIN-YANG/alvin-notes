---
import manifest from '../../vendor/system-design-primer/manifest.json';
const document = manifest.supplements.find(doc => doc.url === Astro.url.pathname);
const source = `${manifest.repo}/blob/${manifest.commit}/${document?.sourcePath || 'README-zh-Hans.md'}`;
const englishSource = !document?.translated && !document?.siteSupplement ? `${manifest.repo}/blob/${manifest.commit}/${(document?.sourcePath || 'README-zh-Hans.md').replace('README-zh-Hans.md', 'README.md')}` : null;
---
<aside class="primer-source" aria-label="文档来源" data-pagefind-ignore data-reader-ignore>
  {document?.siteSupplement ? (<>
    <p>本站补充 · Alvin Yang。原仓库未提供本题解答，本页为本站新增内容。</p>
    <p><a href="/system-design/object-oriented-design/">返回题目总览</a></p>
  </>) : (<>
  <p>原著 Donne Martin · {document?.translated ? '本页说明由本站译自英文 Notebook，代码与输出保留原样。' : <>译文来自掘金翻译计划，译者署名见<a href="/system-design/">首章</a>。</>}</p>
  <p><a href={source}>{document?.translated ? 'Notebook 原文' : '中文原文'}</a> · <a href={`${manifest.repo}/blob/${manifest.commit}/LICENSE.txt`}>CC BY 4.0</a> · 版本 {manifest.commit.slice(0, 7)}。{englishSource ? <>本站依据同版本<a href={englishSource}>英文原文</a>补译与校订，保留原始译文快照。</> : '本站仅做拆章、链接修复与阅读展示适配。'}</p>
  </>)}
</aside>
<script>
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element) || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = event.target.closest<HTMLAnchorElement>('[data-primer-image]');
    const source = link?.querySelector('img');
    if (!link || !source || document.querySelector('.primer-image-dialog')) return;
    event.preventDefault();
    const dialog = document.createElement('dialog');
    dialog.className = 'primer-image-dialog';
    dialog.setAttribute('aria-label', '查看原图');
    const controls = document.createElement('div');
    controls.className = 'primer-image-controls';
    const zoom = document.createElement('button');
    zoom.type = 'button';
    zoom.textContent = '原始尺寸';
    const close = document.createElement('button');
    close.type = 'button';
    close.textContent = '关闭';
    close.autofocus = true;
    controls.append(zoom, close);
    const canvas = document.createElement('div');
    canvas.className = 'primer-image-canvas';
    canvas.tabIndex = 0;
    canvas.setAttribute('aria-label', '图片，可滚动查看');
    const img = source.cloneNode() as HTMLImageElement;
    img.loading = 'eager';
    canvas.append(img);
    dialog.append(controls, canvas);
    document.body.append(dialog);
    zoom.addEventListener('click', () => {
      const expanded = dialog.classList.toggle('primer-image-expanded');
      zoom.textContent = expanded ? '适应窗口' : '原始尺寸';
      canvas.scrollTo(0, 0);
    });
    close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', e => { if (e.target === dialog) dialog.close(); });
    const previousOverflow = document.body.style.overflow;
    dialog.addEventListener('close', () => {
      dialog.remove();
      document.body.style.overflow = previousOverflow;
      link.focus({ preventScroll: true });
    }, { once: true });
    document.body.style.overflow = 'hidden';
    dialog.showModal();
  });
</script>
