<programmer-aside class="programmer-aside">
  <button class="programmer-avatar" type="button" aria-label="听听 Alvin 怎么说" aria-expanded="false">
    <span class="programmer-portrait" aria-hidden="true"></span>
  </button>
  <div class="programmer-bubble" role="status" aria-live="off" aria-atomic="true" aria-hidden="true">
    <span class="programmer-quip"></span>
  </div>
</programmer-aside>

<style>
  .programmer-aside {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: max-content;
    pointer-events: none;
  }

  .programmer-bubble {
    position: relative;
    width: max-content;
    max-width: min(25rem, calc(100vw - 8rem));
    padding: 0.8rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 1.25rem;
    background: color-mix(in srgb, var(--sl-color-surface) 96%, transparent);
    box-shadow: 0 0.75rem 2.2rem rgba(36, 41, 47, 0.12);
    color: var(--sl-color-gray-1);
    font-family: var(--sl-font-mono);
    font-size: 0.82rem;
    line-height: 1.65;
    opacity: 0;
    transform: translate3d(-0.45rem, 0, 0) scale(0.96);
    transform-origin: left center;
    visibility: hidden;
    transition:
      opacity 180ms ease,
      transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 0s linear 220ms;
  }

  .programmer-bubble::after {
    position: absolute;
    top: calc(50% - 0.35rem);
    left: -0.38rem;
    width: 0.7rem;
    height: 0.7rem;
    border-left: 1px solid var(--sl-color-gray-5);
    border-bottom: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-surface);
    content: '';
    transform: rotate(45deg);
  }

  .programmer-aside[data-open] .programmer-bubble {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
    visibility: visible;
    transition-delay: 0s;
  }

  .programmer-avatar {
    position: relative;
    flex: 0 0 auto;
    width: 4.6rem;
    height: 4.6rem;
    overflow: hidden;
    padding: 0;
    border: 0;
    border-radius: 1.45rem;
    background: transparent;
    cursor: pointer;
    pointer-events: auto;
    transition: transform 180ms ease;
  }

  .programmer-avatar:hover {
    transform: translateY(-2px);
  }

  .programmer-avatar:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--sl-color-accent) 34%, transparent);
    outline-offset: 3px;
  }

  .programmer-portrait {
    position: absolute;
    inset: 0;
    display: block;
    background: transparent url('/images/brand/alvin-programmer-transparent.webp') 50% 0 / 360% auto no-repeat;
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .programmer-aside[data-open] .programmer-portrait {
    transform: scale(1.025);
  }

  @media (max-width: 40rem) {
    .programmer-aside {
      gap: 0.6rem;
    }

    .programmer-avatar {
      width: 3.75rem;
      height: 3.75rem;
      border-radius: 1.15rem;
    }

    .programmer-bubble {
      max-width: calc(100vw - 6.2rem);
      padding: 0.7rem 0.85rem;
      border-radius: 1.1rem;
      font-size: 0.76rem;
      line-height: 1.55;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .programmer-bubble,
    .programmer-avatar,
    .programmer-portrait {
      transition: none;
    }
  }

  @media print {
    .programmer-aside {
      display: none;
    }
  }
</style>

<script>
  import { programmerQuips } from '../data/programmer-quips';

  const FIRST_MESSAGE_MIN_MS = 4500;
  const FIRST_MESSAGE_RANGE_MS = 3000;
  const REPEAT_MESSAGE_MIN_MS = 18000;
  const REPEAT_MESSAGE_RANGE_MS = 12000;
  const VISIBILITY_RETRY_MIN_MS = 6000;
  const VISIBILITY_RETRY_RANGE_MS = 4000;
  const MESSAGE_VISIBLE_MS = 7600;

  class ProgrammerAside extends HTMLElement {
    private quips: readonly string[] = programmerQuips;
    private lastIndex = -1;
    private autoTimer = 0;
    private hideTimer = 0;
    private button: HTMLButtonElement | null = null;
    private bubble: HTMLElement | null = null;
    private output: HTMLElement | null = null;

    connectedCallback() {
      if (this.button) return;

      this.button = this.querySelector('.programmer-avatar');
      this.bubble = this.querySelector('.programmer-bubble');
      this.output = this.querySelector('.programmer-quip');
      if (!this.button || !this.bubble || !this.output || this.quips.length === 0) return;

      this.button.addEventListener('click', this.handleClick);
      this.scheduleAutoMessage('first');
    }

    disconnectedCallback() {
      window.clearTimeout(this.autoTimer);
      window.clearTimeout(this.hideTimer);
      this.button?.removeEventListener('click', this.handleClick);
      this.button = null;
      this.bubble = null;
      this.output = null;
    }

    private handleClick = () => {
      window.clearTimeout(this.autoTimer);
      if (this.hasAttribute('data-open')) {
        this.hideMessage();
        return;
      }
      this.showNextMessage(true);
    };

    private scheduleAutoMessage(timing: 'first' | 'repeat' | 'visibility-retry') {
      window.clearTimeout(this.autoTimer);
      const [minimum, range] = timing === 'first'
        ? [FIRST_MESSAGE_MIN_MS, FIRST_MESSAGE_RANGE_MS]
        : timing === 'repeat'
          ? [REPEAT_MESSAGE_MIN_MS, REPEAT_MESSAGE_RANGE_MS]
          : [VISIBILITY_RETRY_MIN_MS, VISIBILITY_RETRY_RANGE_MS];
      const delay = minimum + Math.floor(Math.random() * range);

      this.autoTimer = window.setTimeout(() => {
        if (!this.isReadyToSpeak()) {
          this.scheduleAutoMessage('visibility-retry');
          return;
        }

        this.showNextMessage(false);
      }, delay);
    }

    private isReadyToSpeak() {
      if (document.hidden || this.hasAttribute('data-open')) return false;
      const rect = this.getBoundingClientRect();
      return rect.bottom > 0
        && rect.top < window.innerHeight
        && rect.right > 0
        && rect.left < window.innerWidth;
    }

    private showNextMessage(announce: boolean) {
      if (!this.button || !this.bubble || !this.output) return;

      window.clearTimeout(this.autoTimer);
      let nextIndex = Math.floor(Math.random() * this.quips.length);
      if (this.quips.length > 1 && nextIndex === this.lastIndex) {
        nextIndex = (nextIndex + 1) % this.quips.length;
      }
      this.lastIndex = nextIndex;
      this.bubble.setAttribute('aria-live', announce ? 'polite' : 'off');
      this.output.textContent = this.quips[nextIndex];
      this.setAttribute('data-open', '');
      this.button.setAttribute('aria-expanded', 'true');
      this.bubble.setAttribute('aria-hidden', 'false');

      window.clearTimeout(this.hideTimer);
      this.hideTimer = window.setTimeout(() => this.hideMessage(), MESSAGE_VISIBLE_MS);
    }

    private hideMessage() {
      this.removeAttribute('data-open');
      this.button?.setAttribute('aria-expanded', 'false');
      this.bubble?.setAttribute('aria-hidden', 'true');
      window.clearTimeout(this.hideTimer);
      if (this.isConnected) this.scheduleAutoMessage('repeat');
    }
  }

  if (!customElements.get('programmer-aside')) {
    customElements.define('programmer-aside', ProgrammerAside);
  }
</script>
