---
import { portfolio } from '../data/portfolio';
import { aiCharacters, characterImageRoot } from '../data/ai-characters';
---

<section class="portfolio-page not-content" aria-labelledby="_top">
  <header class="portfolio-intro">
    <h1 id="_top">独立作品集</h1>
    <p><a href="/projects/game-guides/">浏览游戏攻略站 →</a></p>
  </header>

  <div class="portfolio-grid">
    {portfolio.map((project) => (
      <article class="portfolio-card" id={project.id} aria-labelledby={`${project.id}-title`}>
        <header class="portfolio-card-head">
          {project.icon ? (
            <img class="portfolio-icon" src={project.icon} width="48" height="48" alt="" loading="lazy" />
          ) : (
            <span class="portfolio-mark" aria-hidden="true">{project.mark}</span>
          )}
          <div>
            <h2 id={`${project.id}-title`}>{project.name}</h2>
            <p class="portfolio-category">{project.category}</p>
          </div>
          <span class="portfolio-status">{project.status}</span>
        </header>

        <p class="portfolio-summary">{project.summary}</p>
        <p class="portfolio-detail">{project.implementation}</p>

        <footer class="portfolio-card-footer">
          <p class="portfolio-stack" aria-label="技术与实现方向">{project.stack.join(' · ')}</p>
          <div class="portfolio-links">
            {project.links.map((link) => (
              <a href={link.href} target="_blank" rel="noreferrer" aria-label={`${link.label}：${project.name}`}>
                {link.label}<span aria-hidden="true"> ↗</span>
              </a>
            ))}
          </div>
        </footer>
      </article>
    ))}
  </div>

  <section class="character-preview" aria-labelledby="character-preview-title">
    <header>
      <h2 id="character-preview-title"><a href="/projects/ai-characters/">AI 角色立绘 <span aria-hidden="true">→</span></a></h2>
      <p>八位大模型拟人角色 · 电影写实</p>
    </header>
    <a class="character-preview-strip" href="/projects/ai-characters/" aria-label="浏览八位 AI 角色的完整立绘">
      {aiCharacters.map((character) => (
        <img src={`${characterImageRoot}/${character.id}-preview.webp`} alt="" width="512" height="768" loading="lazy" decoding="async" />
      ))}
    </a>
  </section>

  <p class="portfolio-contact"><a href="/about/">关于我</a><span aria-hidden="true"> · </span><a href="https://github.com/ALVIN-YANG" target="_blank" rel="noreferrer">GitHub</a></p>
</section>
