    {
      "id": "interaction",
      "name": "Interaction",
      "company": "The Interaction Company of California",
      "category": "个人助手",
      "region": "海外",
      "product": "Poke",
      "summary": "把个人助手放进已有的聊天工具，用消息管理邮件、日程与日常任务。",
      "status": "加入 Cognition",
      "reviewedAt": "2026-10-13",
      "analysisAt": "2026-10-13",
      "sections": [
        {
          "id": "product",
          "title": "核心产品",
          "rows": [
            {
              "label": "产品与用户",
              "text": "Poke 面向个人用户，直接在 Apple Messages、Telegram、WhatsApp 和 RCS 中提供助手服务，不需要安装独立的 Poke App。账户、隐私和集成也可在网页管理。",
              "kind": "disclosed",
              "sources": [
                "product",
                "faq"
              ],
              "asOf": "2026-10-13",
              "checkedAt": "2026-10-13"
            },
            {
              "label": "具体能力",
              "text": "连接邮件、日历等服务后，用户可通过消息处理邮件、安排日程、设置提醒、搜索网页，并用 Recipes 模板建立自动化。",
              "kind": "disclosed",
              "sources": [
                "product",
                "integrations"
              ],
              "asOf": "2026-10-13",
              "checkedAt": "2026-10-13"
            },
            {
              "label": "付费理由",
              "text": "价值在于减少切换工具和重复操作，让助手利用已授权的个人上下文持续完成任务。是否值得付费，应看任务完成率与实际省下的时间。",
              "kind": "analysis",
              "sources": [
                "product",
                "integrations"
              ],
              "asOf": "2026-10-13",
              "checkedAt": "2026-10-13"
            }
          ]
        },
        {
          "id": "workflow",
          "title": "实际工作流程",
          "rows": [
            {
              "label": "使用示例",
              "text": "连接邮箱和日历后，在聊天中要求整理待回复邮件、寻找空闲时间并安排会议；结果仍需核对收件人、时间及实际执行情况。",
              "kind": "analysis",
              "sources": [
                "product",
                "integrations"
              ],
              "asOf": "2026-10-13",
              "checkedAt": "2026-10-13"
            },
            {
              "label": "人工执行",
              "text": "Poke Human 可把现实世界任务交给真人处理，属于 Ultra 方案；实际发生的采购、出行等费用另按成本扣除。",
              "kind": "disclosed",
              "sources": [
                "faq",
                "updates"
              ],
              "asOf": "2026-10-13",
              "checkedAt": "2026-10-13"
            },
            {
              "label": "能力边界",
              "text": "这是通过已支持的集成调用服务，并不意味着能任意操作手机上所有 App。FAQ 当前列出 Gmail、Outlook，且暂无支持 iCloud、Yahoo 的计划；敏感操作仍需确认授权和结果。",
              "kind": "analysis",
              "sources": [
                "faq",
                "integrations"
              ],
              "asOf": "2026-10-13",
              "checkedAt": "2026-10-13"
            }
          ],
          "steps": [
            "授权邮箱、日历等服务",
            "在消息中交代任务，助手调用集成",
            "收到结果，核对并继续安排"
          ]
        },
        {
          "id": "pricing",
          "title": "价格与使用条件",
          "rows": [
            {
              "label": "计费方式",
              "text": "官方当前提供 Free（0 美元/月）、Pro（19 美元/月）和 Ultra（199 美元/月）。Ultra 超出包含额度后可按用量付费；Poke Human 的实际支出另付。",
              "kind": "disclosed",
              "sources": [
                "pricing",
                "faq"
              ],
              "asOf": "2026-10-13",
              "checkedAt": "2026-10-13"
            },
            {
              "label": "成本怎么比",
              "text": "比较每项完成并验收任务的总成本，包括订阅、额外用量、真人执行支出与人工核对时间；消息量不能替代有效任务量。",
              "kind": "analysis",
              "sources": [
                "pricing",
                "faq"
              ],
              "asOf": "2026-10-13",
              "checkedAt": "2026-10-13"
            }
          ]
        },
        {
          "id": "competition",
          "title": "竞争与商业壁垒",
          "rows": [
            {
              "label": "替代方案",
              "text": "手机系统助手、通用 AI 助手的任务功能、邮件与日历自动化，以及真人助理，都可能解决同一类个人事务。",
              "kind": "analysis",
              "sources": [
                "product",
                "integrations"
              ],
              "asOf": "2026-10-13",
              "checkedAt": "2026-10-13"
            },
            {
              "label": "可能的优势",
              "text": "已有聊天入口降低使用门槛；长期授权的个人上下文、Recipes 和主动处理任务的习惯，可能带来迁移成本。入口方便本身不足以证明壁垒。",
              "kind": "analysis",
              "sources": [
                "product",
                "integrations",
                "investor"
              ],
              "asOf": "2026-10-13",
              "checkedAt": "2026-10-13"
            },
            {
              "label": "失效条件",
              "text": "入口依赖消息平台的接入与政策，集成授权也可能失效。如果系统助手提供同样可靠的执行和更低成本，Poke 的便利性优势会缩小。",
              "kind": "analysis",
              "sources": [
                "product",
                "integrations"
              ],
              "asOf": "2026-10-13",
              "checkedAt": "2026-10-13"
            }
          ]
        },
