---
import AgentKnowledgeMap from '../components/AgentKnowledgeMap.astro';
import KnowledgeMapPage from '../layouts/KnowledgeMapPage.astro';
import aiInfraKnowledge from '../data/ai-infra-knowledge';
---

<KnowledgeMapPage
  title="AI Infra 学习地图"
  description="AI Infra 技术学习：模型执行、KV cache、批处理调度与性能分析，包含推导、完整算例和可运行实验。"
>
  <AgentKnowledgeMap
    data={aiInfraKnowledge}
    title="AI Infra 学习地图"
    mapId="ai-infra"
    panelSourceTitle="官方资料"
    sourceLink={{ label: '四节技术课程', href: '/ai-infra/learning-path/' }}
    levelLabels={{ core: '基础', scenario: '实验', advanced: '进阶' }}
  />
</KnowledgeMapPage>
