---
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getISOWeek, parseWeeklyReport } from '../../lib/weekly-report.mjs';

const reports = (await getCollection('docs'))
  .filter(entry => /^ai-news\/\d{4}-\d{2}-\d{2}-weekly$/.test(entry.id))
  .map(entry => {
    const date = entry.data.date instanceof Date
      ? entry.data.date.toISOString().slice(0, 10)
      : String(entry.data.date || entry.data.lastUpdated).slice(0, 10);
    const report = parseWeeklyReport(entry.body || '', entry.data);
    return {
      slug: entry.id.split('/').pop(),
      date,
      issue: getISOWeek(date),
      title: report.headline,
      description: entry.data.description,
      storyCount: report.storyCount,
      readMinutes: report.readMinutes,
    };
  })
  .sort((a, b) => b.date.localeCompare(a.date));

const latest = reports[0];
const history = reports.slice(1);
const sourceGroups = [
  { label: '一手发布', detail: '官方博客、产品文档与 GitHub Releases' },
  { label: '开发者与社区', detail: '独立开发者、Hacker News 与开源趋势' },
  { label: '媒体核对', detail: 'TechCrunch、The Decoder、InfoQ 与 IT之家' },
];

function formatDate(value) {
  return value.replace(/-/g, '.');
}
---

<StarlightPage
  frontmatter={{
    title: 'AI 周报',
    description: '每周整理真正影响 AI Agent 开发、部署与技术选择的变化。',
    template: 'splash',
    hidePageTitle: true,
  }}
  sidebar={[]}
>
  <main class="news-home">
    <header class="news-intro">
      <div>
        <p>AI WEEKLY</p>
        <h1 id="_top">每周留下值得回看的 AI 工程变化</h1>
        <span>每日采集只留在内部。周报合并重复信息，回到原始来源，再说明它会影响哪一步工作。</span>
      </div>
      <div class="issue-total"><strong>{reports.length}</strong><span>期周报</span></div>
    </header>

    {latest && (
      <section class="latest-report">
        <a href={`/ai-news/${latest.slug}/`}>
          <div class="latest-meta"><span>最新一期</span><b>VOL. {latest.issue}</b></div>
          <h2>{latest.title}</h2>
          <p>{latest.description}</p>
          <div class="latest-footer">
            <time datetime={latest.date}>{formatDate(latest.date)}</time>
            <span>{latest.storyCount} 条信息 · 约 {latest.readMinutes} 分钟</span>
            <b>阅读本期 <i aria-hidden="true">→</i></b>
          </div>
        </a>
      </section>
    )}

    <section class="source-panel" aria-labelledby="sources-title">
      <div class="panel-heading">
        <span>REPORTING</span>
        <h2 id="sources-title">信源怎样进入周报</h2>
      </div>
      <div class="source-grid">
        {sourceGroups.map((group, index) => (
          <div><b>{String(index + 1).padStart(2, '0')}</b><strong>{group.label}</strong><span>{group.detail}</span></div>
        ))}
      </div>
    </section>

    {history.length > 0 && (
      <section class="history-panel" aria-labelledby="history-title">
        <div class="panel-heading">
          <span>ARCHIVE</span>
          <h2 id="history-title">往期周报</h2>
        </div>
        <div class="history-grid">
          {history.map(report => (
            <a href={`/ai-news/${report.slug}/`}>
              <div><b>{report.issue}</b><time datetime={report.date}>{formatDate(report.date)}</time></div>
              <h3>{report.title}</h3>
            <span>{report.storyCount > 0 ? `${report.storyCount} 条信息 · ` : ''}{report.readMinutes} 分钟 <i aria-hidden="true">→</i></span>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</StarlightPage>

<style>
  .news-home {
    --news-ink: #292e2c;
    --news-muted: #777d79;
    --news-blue: #4776c5;
    --news-blue-soft: #e8eef8;
    --news-paper: rgba(255,255,252,.72);
    width: min(100%, 68rem);
    margin-inline: auto;
    padding-bottom: 4rem;
    color: var(--news-ink);
  }
  .news-home a { text-decoration: none !important; }
  .news-home h2, .news-home h3 { padding-bottom: 0; border-bottom: 0; }
  .news-intro { display: flex; align-items: end; justify-content: space-between; gap: 2rem; padding: 1.4rem .25rem 1.8rem; }
  .news-intro p, .panel-heading > span { margin: 0 0 .55rem; color: var(--news-blue); font-family: var(--sl-font-mono); font-size: .66rem; font-weight: 700; letter-spacing: .1em; }
  .news-intro h1 { max-width: 40rem; margin: 0; font-size: clamp(2rem, 5vw, 3.15rem); font-weight: 650; letter-spacing: -.03em; line-height: 1.18; text-wrap: balance; }
  .news-intro > div > span { display: block; max-width: 38rem; margin-top: .85rem; color: var(--news-muted); font-size: .92rem; line-height: 1.7; }
  .issue-total { flex: 0 0 auto; display: grid; justify-items: end; padding-bottom: .2rem; }
  .issue-total strong { color: var(--news-blue); font-family: var(--sl-font-mono); font-size: 2.3rem; line-height: 1; }
  .issue-total span { margin-top: .25rem; color: var(--news-muted); font-size: .7rem; }

  .latest-report > a { position: relative; display: block; overflow: hidden; padding: 1.75rem 1.9rem; border-radius: 1.1rem; color: inherit; background: linear-gradient(115deg, var(--news-blue-soft), rgba(255,255,252,.92) 68%); box-shadow: var(--paper-shadow); text-decoration: none; }
  .latest-report > a::after { content: ''; position: absolute; inset: auto -3rem -5rem auto; width: 12rem; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgba(71,118,197,.14), transparent 68%); }
  .latest-report > a:hover h2 { color: var(--news-blue); }
  .latest-meta { display: flex; gap: .8rem; color: var(--news-blue); font-family: var(--sl-font-mono); font-size: .66rem; letter-spacing: .07em; }
  .latest-report h2 { max-width: 42rem; margin: .7rem 0 .5rem; font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 650; line-height: 1.35; text-wrap: balance; transition: color .16s ease; }
  .latest-report p { max-width: 42rem; margin: 0; color: var(--news-muted); font-size: .86rem; line-height: 1.65; }
  .latest-footer { position: relative; z-index: 1; display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1.2rem; margin-top: 1.1rem; color: var(--news-muted); font-family: var(--sl-font-mono); font-size: .68rem; }
  .latest-footer b { margin-left: auto; color: var(--news-blue); font-family: var(--sl-font); font-size: .76rem; }
  i { font-style: normal; }

  .source-panel, .history-panel { margin-top: 2rem; }
  .panel-heading h2 { margin: 0; font-size: 1.25rem; font-weight: 650; }
  .source-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; margin-top: .8rem; }
  .source-grid > div { display: grid; grid-template-columns: 1.5rem 1fr; gap: .2rem .5rem; padding: 1rem; border-radius: .8rem; background: var(--news-paper); }
  .source-grid b { grid-row: 1 / 3; color: var(--news-blue); font-family: var(--sl-font-mono); font-size: .64rem; }
  .source-grid strong { font-size: .82rem; font-weight: 650; }
  .source-grid span { color: var(--news-muted); font-size: .7rem; line-height: 1.5; }

  .history-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .7rem; margin-top: .8rem; }
  .history-grid > a { display: grid; min-height: 9rem; padding: 1rem; border-radius: .8rem; color: inherit; background: var(--news-paper); text-decoration: none; transition: transform .16s ease, background .16s ease, box-shadow .16s ease; }
  .history-grid > a:hover { transform: translateY(-2px); background: rgba(255,255,253,.94); box-shadow: 0 10px 24px rgba(39,43,41,.04); }
  .history-grid > a > div { display: flex; justify-content: space-between; color: var(--news-muted); font-family: var(--sl-font-mono); font-size: .62rem; }
  .history-grid > a > div b { color: var(--news-blue); }
  .history-grid h3 { margin: .65rem 0; font-size: .9rem; font-weight: 620; line-height: 1.5; }
  .history-grid > a > span { align-self: end; display: flex; justify-content: space-between; color: var(--news-muted); font-size: .66rem; }
  .history-grid i { color: var(--news-blue); }

  :global([data-theme='dark']) .news-home { --news-ink: #e7e7df; --news-muted: #a1a6a1; --news-blue: #8caee3; --news-blue-soft: rgba(76,111,164,.2); --news-paper: rgba(39,41,38,.72); }

  @media (max-width: 48rem) {
    .news-intro { align-items: start; }
    .issue-total { display: none; }
    .news-intro h1 { font-size: clamp(1.85rem, 9vw, 2.5rem); }
    .source-grid, .history-grid { grid-template-columns: 1fr; }
    .source-grid { gap: .5rem; }
    .history-grid > a { min-height: 7.5rem; }
    .latest-report > a { padding: 1.35rem 1.2rem; }
    .latest-footer b { width: 100%; margin-left: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .latest-report h2, .history-grid > a { transition: none; }
  }
</style>
