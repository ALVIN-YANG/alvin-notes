---
import AgentKnowledgeMap from '../components/AgentKnowledgeMap.astro';
import algorithmKnowledge from '../data/algorithm-knowledge';
import KnowledgeMapPage from '../layouts/KnowledgeMapPage.astro';
---

<KnowledgeMapPage
  title="算法能力地图"
  description="按数据结构、解题模式与工程实现梳理算法面试知识点。"
>
  <AgentKnowledgeMap
    data={algorithmKnowledge}
    title="算法能力地图"
    mapId="algorithm"
    panelSourceTitle="参考位置"
    levelLabels={{ core: '基础', scenario: '高频', advanced: '进阶' }}
  />
</KnowledgeMapPage>
