---
import AgentKnowledgeMap from '../components/AgentKnowledgeMap.astro';
import systemDesignKnowledge from '../data/system-design-knowledge';
import KnowledgeMapPage from '../layouts/KnowledgeMapPage.astro';

const primerUrl = 'https://github.com/donnemartin/system-design-primer';
const licenseUrl = 'https://github.com/donnemartin/system-design-primer/blob/master/LICENSE.txt';
---

<KnowledgeMapPage
  title="系统设计能力地图"
  description="完整覆盖 System Design Primer，从面试主线、系统组件到八道系统题与七道面向对象设计题。"
>
  <AgentKnowledgeMap
    data={systemDesignKnowledge}
    title="系统设计能力地图"
    mapId="system-design"
    panelSourceTitle="权威资料"
    sourceLink={{
      label: 'Primer · 完整覆盖',
      href: primerUrl,
      title: `完整覆盖 System Design Primer，内容遵循 ${licenseUrl}`,
    }}
    levelLabels={{ core: '核心', scenario: '实战', advanced: '进阶' }}
  />
</KnowledgeMapPage>
