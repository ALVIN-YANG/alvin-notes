---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CompanyNav from '../../components/CompanyNav.astro';
import CompanyUpdate from '../../components/CompanyUpdate.astro';
import catalog from '../../data/companies/catalog.json';
import updates from '../../data/companies/updates.json';
import { dateLabel } from '../../lib/company-observer.mjs';
---
<StarlightPage frontmatter={{ title: '历史动态 · AI 公司观察', description: '此前核实的公司动态，保留原始日期与来源。', template: 'splash', hidePageTitle: true }} sidebar={[]}>
  <div class="company-observer not-content">
    <header class="co-heading"><div><h1 id="_top">历史动态</h1><p>此前核实的事件，保留原始日期和来源。</p></div><span>已停止更新</span></header>
    <CompanyNav active="changes" />
    <p class="co-notice">栏目已改为每月同步公司目录，不再监控变化或生成周报。以下记录截至 2026.10.13。</p>
    {updates.reports.map((report, index) => <section class="co-report" aria-labelledby={`report-${report.id}`}>
      <header><div><p class="co-kicker">{index === 0 ? '最新一期' : '往期记录'} · {dateLabel(report.start)} — {dateLabel(report.end)}</p><h2 id={`report-${report.id}`}>{report.summary}</h2></div><span>{report.items.length} 条 · 发布 {dateLabel(report.publishedAt)}</span></header>
      {report.items.length ? report.items.map(item => <CompanyUpdate item={item} company={catalog.companies.find(company => company.id === item.companyId)} />) : <p class="co-muted">本期没有收录新的已核实事件，历史消息保留在相应公司档案中。</p>}
    </section>)}
  </div>
</StarlightPage>
