---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CompanyNav from '../../components/CompanyNav.astro';
import directory from '../../data/companies/directory.json';
import analyses from '../../data/companies/employee-analyses.json';
import CompanyEmployeeAnalysis from '../../components/CompanyEmployeeAnalysis.astro';
import { analysisFor, employeeAnalysisLabels, validateEmployeeAnalyses } from '../../lib/company-employee-analysis.mjs';
import { directoryCategories, directoryRegions, inRegion, dateLabel, validateDirectory } from '../../lib/company-directory.mjs';
validateDirectory(directory);
validateEmployeeAnalyses(analyses);
const categories = directoryCategories.filter(category => directory.companies.some(company => company.category === category));
const covered = directory.companies.filter(company => analysisFor(company, analyses)).length;
---
<StarlightPage frontmatter={{ title: 'AI 公司观察', description: '从员工视角了解 AI 公司的业务、职业积累与风险，查看来源明确的公司级初筛。', template: 'splash', hidePageTitle: true }} sidebar={[]}>
  <div class="company-observer not-content">
    <header class="co-heading"><div><h1 id="_top">AI 公司观察</h1><p>先了解业务，再判断公司与岗位价值。</p></div><span>{directory.companies.length} 家 · {covered} 份员工初筛</span></header>
    <CompanyNav />
    <div class="co-controls" data-company-controls hidden>
      <label class="co-search"><span class="co-sr-only">搜索公司、产品或所在地</span><input type="search" id="company-search" placeholder="搜索公司、产品或所在地" autocomplete="off" /></label>
      <div class="co-filters co-region-filters" role="group" aria-label="按地区筛选">{directoryRegions.map(region => <button type="button" data-company-region={region} aria-pressed={region === '全部'}>{region} <span>{directory.companies.filter(company => inRegion(company, region)).length}</span></button>)}</div>
      <div class="co-filters" role="group" aria-label="按产品方向筛选">{['全部', ...categories].map(category => <button type="button" data-company-category={category} aria-pressed={category === '全部'}>{category}</button>)}</div>
    </div>
    <p class="co-filter-status" data-company-status aria-live="polite" aria-atomic="true"></p>
    <div class="co-directory">
      {directory.companies.map(company => { const report = analysisFor(company, analyses); return <article class="co-card" data-company-card data-category={company.category} data-region={company.region} data-hangzhou={inRegion(company, '杭州') ? 'true' : 'false'} data-search={`${company.name} ${(company.aliases || []).join(' ')} ${company.summary} ${report?.publicSummary || ''} ${company.location} ${company.category}`}>
        <div class="co-card-top"><span>{company.category}</span><span>{company.city === '杭州' ? '国内 · 杭州' : company.region}{company.hangzhouTeam && ' · 杭州团队'}</span></div>
        <h2><a href={`/companies/${company.id}/`} data-company-open={company.id} aria-haspopup="dialog" aria-label={`${company.name}，查看员工视角分析`}>{company.name}</a></h2>
        <p class="co-card-summary">{report?.publicSummary || company.summary}</p>
        {report && <p class="co-card-teaser">{report.teaser}</p>}
        <div class="co-card-bottom"><span class="cea-status" data-level={report?.level || 'limited'}>{report ? employeeAnalysisLabels[report.level] : '员工分析待补'}</span><span>{report ? `分析 ${dateLabel(report.reviewedAt)}` : `资料 ${dateLabel(company.activity.asOf)}`}</span><a href={company.website} target="_blank" rel="noopener noreferrer">官网 ↗</a></div>
        <p class="co-card-source">来源：<a href={report?.sources[0].url || company.sources[0].url} target="_blank" rel="noopener noreferrer">{report?.sources[0].title || company.sources[0].title} ↗</a></p>
        <template data-company-template={company.id}><CompanyEmployeeAnalysis company={company} report={report} inDialog={true} /></template>
      </article>; })}
    </div>
    <div class="co-empty" data-company-empty hidden><p>没有匹配的公司。</p><button type="button" data-company-reset>清除搜索与筛选</button></div>
    <p class="co-footnote">杭州属于国内，总数去重。员工初筛基于公开资料，事实、推断与待核实事项分开，不作前景排名。点击卡片查看分析与来源；按住 Command / Ctrl 点击可打开独立公司页。<a href="/companies/methodology/">收录规则与分析口径</a> · <a href="/companies/methodology/#hangzhou-supplements">杭州产品补充</a> · <a href="/companies/methodology/#hangzhou-coverage">官方名单比对</a></p>
    <dialog class="co-analysis-dialog" data-company-dialog aria-labelledby="co-dialog-company-title"><div class="co-dialog-bar"><span>公司详情 / 员工视角</span><button type="button" data-company-close aria-label="关闭公司详情">×</button></div><div class="co-dialog-content" data-company-dialog-content></div></dialog>
  </div>
</StarlightPage>
<script>import { setupCompanyDirectory, setupCompanyAnalysis } from '../../scripts/company-directory'; setupCompanyDirectory(); setupCompanyAnalysis();</script>
