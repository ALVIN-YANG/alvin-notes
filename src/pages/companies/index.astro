---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CompanyNav from '../../components/CompanyNav.astro';
import directory from '../../data/companies/directory.json';
import { directoryCategories, directoryRegions, inRegion, dateLabel, validateDirectory } from '../../lib/company-directory.mjs';
validateDirectory(directory);
const categories = directoryCategories.filter(category => directory.companies.some(company => company.category === category));
---
<StarlightPage frontmatter={{ title: 'AI 公司观察', description: '浏览活跃 AI 公司的官网、产品方向和信息来源。', template: 'splash', hidePageTitle: true }} sidebar={[]}>
  <div class="company-observer not-content">
    <header class="co-heading"><div><h1 id="_top">AI 公司观察</h1><p>从官网和公开名册，浏览活跃 AI 公司。</p></div><span>{directory.companies.length} 家 · 每月同步名单</span></header>
    <CompanyNav />
    <div class="co-controls" data-company-controls hidden>
      <label class="co-search"><span class="co-sr-only">搜索公司、产品或所在地</span><input type="search" id="company-search" placeholder="搜索公司、产品或所在地" autocomplete="off" /></label>
      <div class="co-filters co-region-filters" role="group" aria-label="按地区筛选">{directoryRegions.map(region => <button type="button" data-company-region={region} aria-pressed={region === '全部'}>{region} <span>{directory.companies.filter(company => inRegion(company, region)).length}</span></button>)}</div>
      <div class="co-filters" role="group" aria-label="按产品方向筛选">{['全部', ...categories].map(category => <button type="button" data-company-category={category} aria-pressed={category === '全部'}>{category}</button>)}</div>
    </div>
    <p class="co-filter-status" data-company-status aria-live="polite" aria-atomic="true"></p>
    <div class="co-directory">
      {directory.companies.map(company => <article class="co-card" data-company-card data-category={company.category} data-region={company.region} data-hangzhou={inRegion(company, '杭州') ? 'true' : 'false'} data-search={`${company.name} ${company.summary} ${company.location} ${company.category}`}>
        <div class="co-card-top"><span>{company.category}</span><span>{company.city === '杭州' ? '国内 · 杭州' : company.region}{company.hangzhouTeam && ' · 杭州团队'}</span></div>
        <h2><a href={`/companies/${company.id}/`}>{company.name}</a></h2>
        <p class="co-card-summary">{company.summary}</p>
        <div class="co-card-sources"><span>信息来源</span>{company.sources.map(source => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>)}</div>
        <div class="co-card-bottom"><span>{company.activity.label} · {dateLabel(company.activity.asOf)}</span><a href={company.website} target="_blank" rel="noopener noreferrer">访问官网 ↗</a></div>
      </article>)}
    </div>
    <div class="co-empty" data-company-empty hidden><p>没有匹配的公司。</p><button type="button" data-company-reset>清除搜索与筛选</button></div>
    <p class="co-footnote">杭州属于国内，总数去重。收录依据是公开产品和活动记录；不代表前景排名或产品实测。简介首次整理后保留，新增名册条目可显示来源原文。<a href="/companies/methodology/">收录规则与数据来源</a></p>
  </div>
</StarlightPage>
<script>import { setupCompanyDirectory } from '../../scripts/company-directory'; setupCompanyDirectory();</script>
