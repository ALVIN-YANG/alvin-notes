---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { careerLibrary, careerTopics } from '../../data/career-library';
const kinds = [{key:'all',label:'全部内容'}, {key:'handbooks',label:'知识手册'}, {key:'resources',label:'精选资源'}];
---
<StarlightPage frontmatter={{title:'职业手册', description:'精选资源与知识手册，按主题查阅、学习与练习。', template:'splash', hidePageTitle:true}} sidebar={[]}>
  <section class="career-library not-content" aria-labelledby="_top">
    <header class="career-heading"><div><span class="career-eyebrow">ALVIN'S LIBRARY</span><h1 id="_top">职业手册</h1></div><p>精选资源与知识手册，留在手边，随时翻阅。</p></header>
    <div class="career-kinds" role="group" aria-label="内容类型">
      {kinds.map(k => <button type="button" data-kind={k.key} aria-pressed={k.key==='all'}>{k.label}<span>{k.key==='all'?careerLibrary.length:careerLibrary.filter(b=>b.kind===k.key).length}</span></button>)}
    </div>
    <div class="career-toolbar"><div class="career-topics" role="group" aria-label="主题筛选">{careerTopics.map(t=><button type="button" data-topic={t.key} aria-pressed={t.key==='all'}>{t.label}</button>)}</div><p class="career-count" role="status" aria-live="polite">共 {careerLibrary.length} 项</p></div>
    <div class="career-shelf">
      {careerLibrary.map((book,i)=><article class="career-book" data-book-kind={book.kind} data-book-topic={book.topic}>
        <a href={book.href} class="career-book-link" aria-label={`${book.title}，${book.note}`}>
          <div class:list={['career-cover',`career-cover-${book.cover}`]} aria-hidden="true">
            <div class="career-cover-top"><span>{book.kind==='handbooks'?'知识手册':'精选资源'}</span><span>{String(i+1).padStart(2,'0')}</span></div>
            <div class="career-cover-title">{book.words.map(w=><span>{w}</span>)}</div>
            <div class="career-cover-subtitle">{book.subtitle}</div>
            <div class="career-cover-bottom">{book.author}</div>
          </div>
          <h2>{book.title}<span aria-hidden="true">{book.href.startsWith('https:')?'↗':'→'}</span></h2>
        </a>
        <p>{book.note}</p>
      </article>)}
    </div>
    <p class="career-empty" hidden>这个分类下暂无内容，试试其他主题。</p>
    <footer class="career-footnote">收录内容保留作者与来源署名。各文档的使用许可见阅读页。</footer>
  </section>
</StarlightPage>
<script>
  const library = document.querySelector<HTMLElement>('.career-library');
  if (library) {
    const kinds = [...library.querySelectorAll<HTMLButtonElement>('[data-kind]')];
    const topics = [...library.querySelectorAll<HTMLButtonElement>('[data-topic]')];
    const books = [...library.querySelectorAll<HTMLElement>('[data-book-kind]')];
    function filter() {
      const params = new URLSearchParams(location.search);
      const kind = kinds.some(b=>b.dataset.kind===params.get('type')) ? params.get('type')! : 'all';
      const topic = topics.some(b=>b.dataset.topic===params.get('topic')) ? params.get('topic')! : 'all';
      kinds.forEach(b=>b.setAttribute('aria-pressed', String(b.dataset.kind===kind)));
      topics.forEach(b=>b.setAttribute('aria-pressed', String(b.dataset.topic===topic)));
      let count = 0;
      books.forEach(b=>{b.hidden = !((kind==='all'||b.dataset.bookKind===kind)&&(topic==='all'||b.dataset.bookTopic===topic));if(!b.hidden)count++;});
      library!.querySelector('.career-count')!.textContent = `共 ${count} 项`;
      library!.querySelector<HTMLElement>('.career-empty')!.hidden = count!==0;
    }
    [...kinds,...topics].forEach(button=>button.addEventListener('click',()=>{
      const url = new URL(location.href);
      const key = button.dataset.kind ? 'type' : 'topic';
      const value = button.dataset.kind || button.dataset.topic!;
      if(value==='all')url.searchParams.delete(key);else url.searchParams.set(key,value);
      history.pushState(null,'',url);filter();
    }));
    window.addEventListener('popstate',filter);filter();
  }
</script>
