---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { ragPractice as guide, ragPracticeMarkdown } from '../../data/rag-practice';

const frontmatter = {
  title: guide.title,
  description: guide.summary,
  template: 'splash' as const,
  hidePageTitle: true,
};
const serializedMarkdown = JSON.stringify(ragPracticeMarkdown()).replace(/</g, '\\u003c');
const demoCommands = [
  'curl -fsSLO https://blog.mlxb.cc/examples/rag-retrieval-demo.py',
  'python3 rag-retrieval-demo.py --self-test',
  'python3 rag-retrieval-demo.py',
].join('\n');
const sample = guide.tokenizer.example;
const visibleToken = (token: string) => token === ' ' ? '空格' : token.startsWith(' ') ? `空格＋${token.slice(1)}` : token;
---

<StarlightPage frontmatter={frontmatter} sidebar={[]}>
  <article class="rag-practice not-content" aria-labelledby="_top">
    <header class="rag-intro">
      <div class="rag-title-row">
        <h1 id="_top">{guide.title}</h1>
        <div class="rag-reader-actions">
          <a href="/rag/实战速查.md">文字版</a>
          <button type="button" data-rag-copy>复制全文</button>
        </div>
      </div>
      <p class="rag-summary">{guide.summary}</p>
      <p class="rag-limit">{guide.limit}</p>
      <div class="rag-meta-row">
        <nav class="rag-jump-links" aria-label="RAG 模块目录">
          <a href="#understand">看懂原理</a>
          <a href="#tokenizer">Tokenizer 与切块</a>
          <a href="#start">开始做</a>
          <a href="#troubleshoot">查问题</a>
          <a href="#verify">验证效果</a>
        </nav>
        <span class="rag-updated">更新于 <time datetime={guide.updatedAt}>{guide.updatedAt}</time></span>
      </div>
      <p class="rag-copy-status" data-rag-copy-status role="status" hidden></p>
    </header>

    <section class="rag-section" id="understand" aria-labelledby="understand-title">
      <h2 id="understand-title">RAG 是什么</h2>
      <div class="rag-principle-text">
        <p>{guide.principle.definition} <a href="#source-definition">定义来源</a></p>
        <p>{guide.principle.purpose}</p>
        <p>{guide.principle.boundary}</p>
      </div>
      <figure class="rag-diagram">
        <a href={guide.diagrams.overview.src} target="_blank" rel="noreferrer" aria-label={`${guide.diagrams.overview.title}，打开大图（新标签页）`}>
          <img src={guide.diagrams.overview.src} alt={guide.diagrams.overview.alt} width={guide.diagrams.overview.width} height={guide.diagrams.overview.height} decoding="async" />
        </a>
        <figcaption>{guide.diagrams.overview.caption} 点击图片查看大图。</figcaption>
      </figure>
      <h3 class="rag-principle-heading">RAG 实现分两步</h3>
      <figure class="rag-diagram">
        <a href={guide.diagrams.implementation.src} target="_blank" rel="noreferrer" aria-label={`${guide.diagrams.implementation.title}，打开大图（新标签页）`}>
          <img src={guide.diagrams.implementation.src} alt={guide.diagrams.implementation.alt} width={guide.diagrams.implementation.width} height={guide.diagrams.implementation.height} loading="lazy" decoding="async" />
        </a>
        <figcaption>{guide.diagrams.implementation.caption} 点击图片查看大图。</figcaption>
      </figure>
      <details class="rag-detail">
        <summary>展开每一步的具体做法</summary>
        <h3 class="rag-principle-heading">导入资料时：准备可搜索的资料库</h3>
        <ol class="rag-flow" aria-label="资料导入和索引构建的三个步骤">
          {guide.principle.preparation.map((step) => <li><strong>{step.title}</strong><span>{step.text}</span></li>)}
        </ol>
        <h3 class="rag-principle-heading">用户提问时：检索，再生成回答</h3>
        <ol class="rag-flow" aria-label="用户提问后的检索与生成三个步骤">
          {guide.principle.answering.map((step) => <li><strong>{step.title}</strong><span>{step.text}</span></li>)}
        </ol>
      </details>
      <details class="rag-detail">
        <summary>程序怎样检索，模型实际收到什么</summary>
        <h3 class="rag-principle-heading">程序怎样找到相关资料</h3>
        <table class="rag-table rag-check-table">
          <thead><tr><th scope="col">检索方式</th><th scope="col">工作原理</th></tr></thead>
          <tbody>{guide.principle.searchMethods.map((method) => <tr><th scope="row">{method.name}</th><td>{method.how}</td></tr>)}</tbody>
        </table>
        <p class="rag-section-note">{guide.principle.searchNote}</p>
        <h3 class="rag-principle-heading">模型实际收到的内容</h3>
        <pre class="rag-model-input"><code>{guide.principle.modelInput}</code></pre>
        <p class="rag-section-note">{guide.principle.inputNote}</p>
      </details>
      <p class="rag-section-note">{guide.fit} <a href="#source-retrieval">方法来源</a></p>
    </section>

    <section class="rag-section" id="tokenizer" aria-labelledby="tokenizer-title">
      <h2 id="tokenizer-title">{guide.tokenizer.title}</h2>
      <div class="rag-principle-text">
        <p>{guide.tokenizer.definition}</p>
        <p>{guide.tokenizer.role} <a href="#source-tokenization">编码原理来源</a></p>
      </div>
      <figure class="rag-diagram">
        <a href={guide.diagrams.tokenizer.src} target="_blank" rel="noreferrer" aria-label={`${guide.diagrams.tokenizer.title}，打开大图（新标签页）`}>
          <img src={guide.diagrams.tokenizer.src} alt={guide.diagrams.tokenizer.alt} width={guide.diagrams.tokenizer.width} height={guide.diagrams.tokenizer.height} loading="lazy" decoding="async" />
        </a>
        <figcaption>{guide.diagrams.tokenizer.caption} 点击图片查看大图。</figcaption>
      </figure>
      <h3 class="rag-principle-heading">同一句话，实际会编码成什么</h3>
      <p class="rag-token-example">“{sample.text}” <span>{sample.characters} 个字符，包含空格和标点。</span></p>
      <p class="rag-section-note">{guide.tokenizer.sampleNote}</p>
      <div class="rag-token-panel">
        <h4>BGE tokenizer：{sample.embedding.contentTokens} 个正文 token + 2 个特殊 token = {sample.embedding.totalTokens}</h4>
        <ul class="rag-token-strip" aria-label="BGE token 及对应词表编号">
          {sample.embedding.tokens.map((token, index) => <li class:list={['rag-token-chip', { 'rag-special-token': sample.embedding.specialMask[index] === 1 }]}><span>{visibleToken(token)}</span><small>{sample.embedding.ids[index]}</small></li>)}
        </ul>
      </div>
      <div class="rag-token-panel">
        <h4>o200k_base：{sample.generation.totalTokens} 个纯文本 token</h4>
        <ul class="rag-token-strip" aria-label="o200k_base token 及对应词表编号">
          {sample.generation.tokens.map((token, index) => <li class="rag-token-chip"><span>{visibleToken(token)}</span><small>{sample.generation.ids[index]}</small></li>)}
        </ul>
      </div>
      <p class="rag-section-note">每个小块上面是 token 表示，下面是词表编号。“空格＋元”表示同一个 token 包含前置空格和“元”。{guide.tokenizer.sampleMeaning}</p>
      <details class="rag-detail">
        <summary>编码细节：BPE、WordPiece、特殊 token 与 padding</summary>
        <dl class="rag-definitions">{guide.tokenizer.pipeline.map((item) => <div><dt>{item.title}</dt><dd>{item.text}</dd></div>)}</dl>
        <dl class="rag-definitions">{guide.tokenizer.algorithms.map((item) => <div><dt>{item.title}</dt><dd>{item.text}</dd></div>)}</dl>
        <p><a href="#source-bpe-wordpiece">BPE 来源</a> · <a href="https://huggingface.co/learn/llm-course/chapter6/6" target="_blank" rel="noreferrer">WordPiece 原理</a></p>
      </details>

      <h3 class="rag-principle-heading">从 token ID 到 Embedding，中间还有模型计算</h3>
      <dl class="rag-definitions">{guide.tokenizer.concepts.map((item) => <div><dt>{item.name}</dt><dd>{item.meaning}</dd></div>)}</dl>
      <p class="rag-section-note">{guide.tokenizer.dimensionNote}</p>
      <p class="rag-section-note">{guide.tokenizer.modelPairing} <a href="#source-bge">模型与聚合方式来源</a></p>
      <p class="rag-section-note">{guide.tokenizer.generation}</p>

      <h3 class="rag-principle-heading" id="chunking">{guide.tokenizer.chunking.title}</h3>
      <p>{guide.tokenizer.chunking.rule}</p>
      <p class="rag-section-note">{guide.tokenizer.chunking.limit}</p>
      <div class="rag-token-case">
        <p><strong>实测截断：{sample.truncation.fullTokens} → {sample.truncation.sentTokens} token，末尾的 500 元规定丢失。</strong></p>
        <p>{guide.tokenizer.chunking.truncation}</p>
        <p>{guide.tokenizer.chunking.repair}</p>
      </div>
      <details class="rag-detail">
        <summary>Overlap 为什么增加成本，按 token 硬切为什么可能乱码</summary>
        <p>{guide.tokenizer.chunking.overlap}</p>
        <p>{guide.tokenizer.chunking.unicode} <a href="#source-tiktoken">tiktoken 来源</a></p>
      </details>
      <table class="rag-table rag-failure-table">
        <thead><tr><th scope="col">哪个阶段</th><th scope="col">用什么计数</th><th scope="col">检查什么</th></tr></thead>
        <tbody>{guide.tokenizer.limits.map((item) => <tr><th scope="row">{item.stage}</th><td><span class="rag-mobile-label">用什么计数：</span>{item.count}</td><td><span class="rag-mobile-label">检查什么：</span>{item.action}</td></tr>)}</tbody>
      </table>

      <h3 class="rag-principle-heading" id="token-budget">{guide.tokenizer.budget.title}</h3>
      <p class="rag-token-formula">{guide.tokenizer.budget.formula}</p>
      <p class="rag-section-note">{guide.tokenizer.budget.example}</p>
      <p class="rag-section-note">{guide.tokenizer.budget.packing}</p>
      <details class="rag-detail">
        <summary>聊天模板怎样计数，实际费用怎样核对</summary>
        <p>{guide.tokenizer.budget.template} <a href="#source-chat-template">聊天模板来源</a></p>
        <p>{guide.tokenizer.budget.cost}</p>
      </details>
      <details class="rag-detail">
        <summary>运行演练：看到真实编号、截断结果、分块与预算</summary>
        <p>{guide.tokenizer.demoNote}</p>
        <pre><code>{guide.tokenizer.demoCommands}</code></pre>
        <p>本页输出使用 Python {sample.versions.python}、tokenizers {sample.versions.tokenizers}、tiktoken {sample.versions.tiktoken}。BGE tokenizer 固定为 <a href={`https://huggingface.co/${sample.versions.model}/blob/${sample.versions.revision}/tokenizer.json`} target="_blank" rel="noreferrer">{sample.versions.model} · {sample.versions.revision.slice(0, 7)}</a>。</p>
        <p>按 128 token 上限切分后的各段长度：{sample.truncation.chunkTokenCounts.join('、')}。末尾规定保留。脚本还用 256 的教学窗口、64 输出预留、16 余量演示：选入 {sample.packing.selectedSources.join('、')}，跳过装不下的 {sample.packing.skippedSources.join('、')}，完整纯文本输入为 {sample.packing.inputTokens} token。该选择只演示容量检查，必要依据被跳过时仍需重新取较小片段或说明不足。</p>
        <pre><code>{guide.tokenizer.code}</code></pre>
        <p><a href="/examples/rag-tokenizer-demo.py">查看完整脚本：按句切块与完整输入预算的实现</a>。首次运行后可用本地缓存复现；示例没有加 overlap，也不解析表格，真实资料须保留条款结构。<a href="#source-input-length">长度与截断参数来源</a></p>
      </details>
    </section>

    <section class="rag-section" id="start" aria-labelledby="start-title">
      <h2 id="start-title">第一版按这五步做</h2>
      <table class="rag-table rag-build-table">
        <thead><tr><th scope="col">做什么</th><th scope="col">具体做法</th><th scope="col">检查结果</th></tr></thead>
        <tbody>{guide.steps.map((step, index) => (
          <tr><th scope="row"><span class="rag-step-number">{index + 1}</span>{step.title}</th><td>{step.action}</td><td><span class="rag-mobile-label">检查结果：</span>{step.check}</td></tr>
        ))}</tbody>
      </table>
      <details class="rag-detail">
        <summary>给模型的回答要求，直接复制再替换资料</summary>
        <pre><code>{guide.prompt}</code></pre>
        <p>Prompt 只能约束回答方式。用户身份、资料权限和生效版本仍由服务端检查。</p>
      </details>
      <details class="rag-detail">
        <summary>本地演练：只找到当前有权查看的资料</summary>
        <p>示例里有旧制度、新制度和财务专用文件。脚本用关键词查找，演练怎样过滤旧版、无权资料和其他公司的文件。</p>
        <pre><code>{demoCommands}</code></pre>
        <p>需要 Python 3.10 或更新版本，无需安装依赖。<a href="/examples/rag-retrieval-demo.py">查看脚本</a>。这只验证资料筛选，不调用模型或向量库，不能证明真实问答质量。</p>
      </details>
    </section>

    <section class="rag-section" id="troubleshoot" aria-labelledby="troubleshoot-title">
      <h2 id="troubleshoot-title">回答错了，按看到的情况查</h2>
      <p class="rag-section-note">例如制度写 500 元，AI 却答 800 元。先看资料，再看这次找到了什么、交给 AI 什么，最后检查回答。</p>
      <table class="rag-table rag-failure-table">
        <thead><tr><th scope="col">看到什么</th><th scope="col">先检查</th><th scope="col">怎样处理</th></tr></thead>
        <tbody>{guide.failures.map((failure) => (
          <tr><th scope="row">{failure.symptom}</th><td><span class="rag-mobile-label">先检查：</span>{failure.inspect}</td><td><span class="rag-mobile-label">怎样处理：</span>{failure.fix}</td></tr>
        ))}</tbody>
      </table>
    </section>

    <section class="rag-section" id="verify" aria-labelledby="verify-title">
      <h2 id="verify-title">改完，用这些问题验证</h2>
      <table class="rag-table rag-check-table">
        <thead><tr><th scope="col">测试什么</th><th scope="col">应该看到的结果</th></tr></thead>
        <tbody>{guide.checks.map((check) => <tr><th scope="row">{check.question}</th><td>{check.expected}</td></tr>)}</tbody>
      </table>
      <p class="rag-section-note">{guide.comparison} <a href="#source-evaluation">方法来源</a></p>
      <details class="rag-detail">
        <summary>需要量化比较时，看这三个指标</summary>
        <dl class="rag-definitions">{guide.metrics.map((metric) => <div><dt>{metric.name}</dt><dd>{metric.meaning}</dd></div>)}</dl>
      </details>
      <details class="rag-detail">
        <summary>交给 AI 实现的任务清单</summary>
        <pre><code>{guide.implementation}</code></pre>
      </details>
    </section>

    <aside class="rag-recap" aria-label="RAG 回顾">
      <h2>回顾时，记住这四句</h2>
      <ol>{guide.recap.map((item) => <li>{item}</li>)}</ol>
    </aside>

    <details class="rag-detail" id="terms">
      <summary>遇到术语，再看这里</summary>
      <dl class="rag-definitions">{guide.glossary.map((item) => <div><dt>{item.term}</dt><dd>{item.meaning}</dd></div>)}</dl>
    </details>
    <footer class="rag-footer">
      <details class="rag-detail" id="sources">
        <summary>方法来源与适用范围</summary>
        <ul class="rag-source-list">{guide.sources.map((source) => (
          <li id={`source-${source.id}`}><a href={source.href} target="_blank" rel="noreferrer">{source.title}</a><p>{source.supports}</p></li>
        ))}</ul>
        <p>权限、版本和更新策略是本页的工程建议，需要在项目中验证。例子用于说明，没有声称已通过生产验收。</p>
      </details>
      <details class="rag-detail">
        <summary>完整教学入口：中文课程、原理拆解与进阶实战</summary>
        <ul class="rag-source-list">{guide.tutorials.map((tutorial) => (
          <li><a href={tutorial.href} target="_blank" rel="noreferrer">{tutorial.title}</a><p>{tutorial.description} <a href={tutorial.start} target="_blank" rel="noreferrer">从这里开始</a></p></li>
        ))}</ul>
      </details>
      <div class="rag-related"><span>需要深入时：</span><a href="/ai/rag-primer/">RAG 技术选型</a><a href="/ai/rag-knowledge-base-component/">知识库落地</a><a href="/ai/rag-metadata-filtering/">资料过滤</a><a href="/agent-knowledge/">Agent 知识地图</a></div>
    </footer>
    <script type="application/json" data-rag-markdown set:html={serializedMarkdown}></script>
  </article>
</StarlightPage>

<script>
  const page = document.querySelector('.rag-practice');
  const copy = page?.querySelector<HTMLButtonElement>('[data-rag-copy]');
  const status = page?.querySelector<HTMLElement>('[data-rag-copy-status]');
  const markdown = page?.querySelector('[data-rag-markdown]')?.textContent;
  copy?.addEventListener('click', async () => {
    if (!status || !markdown) return;
    try {
      await navigator.clipboard.writeText(JSON.parse(markdown));
      status.textContent = '已复制，可用于回顾或交给 AI。';
    } catch {
      status.textContent = '复制失败，请打开文字版选中复制。';
    }
    status.hidden = false;
  });
  // Source links may target content inside a closed native disclosure.
  const revealHash = () => {
    const target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
    if (!target) return;
    let parent = target.parentElement;
    while (parent) {
      if (parent instanceof HTMLDetailsElement) parent.open = true;
      parent = parent.parentElement;
    }
    target.scrollIntoView({ block: 'start' });
  };
  page?.querySelectorAll<HTMLAnchorElement>('a[href^="#source-"]').forEach((link) => {
    link.addEventListener('click', () => {
      const details = page.querySelector<HTMLDetailsElement>('#sources');
      if (details) details.open = true;
    });
  });
  window.addEventListener('hashchange', revealHash);
  if (location.hash) revealHash();
</script>
