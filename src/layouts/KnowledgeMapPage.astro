---
import '../styles/fonts.css';
import '../styles/agent-knowledge-mintlify.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const siteUrl = Astro.site?.href ?? 'https://blog.mlxb.cc';
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL('/images/brand/og-default.png', siteUrl).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f4ed" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title="Alvin Yang" href={new URL('/rss.xml', siteUrl).href} />
    <link
      rel="preload"
      href="/fonts/misans/misans-regular-subset.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <title>{title}</title>
  </head>
  <body>
    <main class="standalone-knowledge-page">
      <slot />
    </main>
    <Analytics />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --sl-font-utility: var(--font-sans);
    --sl-font-mono: var(--font-mono);
  }

  * { box-sizing: border-box; }

  html {
    min-width: 320px;
    background: #f5f4ed;
  }

  body {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    background: #f5f4ed;
  }

  button,
  input { font: inherit; }

  .standalone-knowledge-page {
    min-height: 100svh;
    padding: 0;
  }

  .standalone-knowledge-page > .agent-map {
    width: 100%;
  }
</style>
