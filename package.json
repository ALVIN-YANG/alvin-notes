{
  "name": "alvin-notes",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "concepts:sync": "node scripts/sync-ai-concepts.mjs",
    "concepts:check": "node scripts/sync-ai-concepts.mjs --check",
    "companies:sync": "node scripts/sync-ai-companies.mjs",
    "companies:check": "node scripts/sync-ai-companies.mjs --check",
    "test": "node --test",
    "fonts:update": "node scripts/update-font-subsets.mjs",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/sync-system-design.mjs --check && node scripts/check-system-design-english.mjs && node scripts/sync-phoenix.mjs --check && astro build && node scripts/verify-build-output.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "news:daily": "node scripts/fetch-ai-news.mjs --daily",
    "news:weekly": "node scripts/fetch-ai-news.mjs --weekly",
    "news:fix-language": "node scripts/fetch-ai-news.mjs --fix-language",
    "news:check-language": "node scripts/fetch-ai-news.mjs --check-language",
    "news:check-sources": "node scripts/fetch-ai-news.mjs --check-sources",
    "model-arena:update": "node scripts/fetch-model-arena.mjs",
    "model-arena:check": "node scripts/fetch-model-arena.mjs --check",
    "model-arena:verify": "node scripts/verify-model-arena.mjs",
    "system-design:sync": "node scripts/sync-system-design.mjs",
    "system-design:check": "node scripts/sync-system-design.mjs --check",
    "system-design:english-check": "node scripts/check-system-design-english.mjs",
    "phoenix:sync": "node scripts/sync-phoenix.mjs",
    "phoenix:check": "node scripts/sync-phoenix.mjs --check"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.1.2",
    "@astrojs/starlight": "^0.37.6",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "acorn": "^8.19.0",
    "astro": "^5.6.1",
    "fflate": "^0.8.2",
    "github-slugger": "^2.0.0",
    "marked": "^16.4.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.34.2",
    "tslib": "^2.8.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "isomorphic-mermaid": "^0.1.1",
    "jsdom": "^27.4.0"
  }
}
